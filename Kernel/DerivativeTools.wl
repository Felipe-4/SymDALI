Attributes[genErrorMessage] = HoldAll;

genErrorMessage[test_] := Module[
	{message},
	
	message = ToString[Unevaluated[test]];
	
	If[
		test,
		True,
		"The following Conditions were not satisfied: " <> message
	]
] 


DerivativeCombinations::usage="DerivativeCombinations[vars_, n_, zerothDerivative_]
vars_List: List of variables with respect to which you want derivatives;
n_Integer: max derivative order;
zerothDerivative_?BooleanQ: Whether to include the \"zero derivative\" in the list;
Output: List of all derivatives from order 1 (or zero) to n.
Example:

>>DerivativeCombinations[{x,y}, 2, True]
>>{{{}},{x},{y},{x,x},{x,y},{y,y}}";

DerivativeCombinations[vars_List, n_Integer, zerothDerivative_?BooleanQ]/;n>0 := Module[
	{result},
	
	result  = Table[
			(Sort/@Tuples[vars, i])//DeleteDuplicates,
			{i,n}
	]//Flatten[#,1]&;
	
	If[
		zerothDerivative,
		Prepend[result, {{}}],
		result
	
	]
]

(*I took this from Shiffrin's answer in: https://mathematica.stackexchange.com/questions/29321/what-are-the-best-practices-most-common-idiomatic-ways-to-report-errors-in-m *)

DerivativeCombinations[args___] := Throw[$Failed, failTag[DerivativeCombinations]]


Attributes[$Block] = {HoldAll};

$Block[{{heads___}, othervars___}, expression___] := Block[{heads, othervars}, expression]


DerivativesExpression::usage="DerivativesExpression[expr, derivatives, {kernels}, {keepDefs}]
expr_: expression to take derivatives;
derivatives_List: list of derivatives you want to apply in expr;
{kernels_Integer} || {}: number of kernels on which to parallelize the calculation of derivatives;
{keepDefs___Rule}: definitions of internal variables you want to keep, like S = \!\(\*SuperscriptBox[\(x\), \(2\)]\); A = y+x; and so on;
Output: List containing all derivatives of \"expr_\" as specified in \"derivatives_List\".
Example:

DerivativesExpression[g[x] h[\!\(\*SuperscriptBox[\(x\), \(2\)]\)], {{x}, {x,x}}, {}, {S-> \!\(\*SuperscriptBox[\(x\), \(2\)]\)}]
>>>{
	h[S] \!\(\*SuperscriptBox[\(g\), \(\[Prime]\),\nMultilineFunction->None]\)[x]+2 x g[x] \!\(\*SuperscriptBox[\(h\), \(\[Prime]\),\nMultilineFunction->None]\)[S],
	2 g[x] \!\(\*SuperscriptBox[\(h\), \(\[Prime]\),\nMultilineFunction->None]\)[S]+4 x \!\(\*SuperscriptBox[\(g\), \(\[Prime]\),\nMultilineFunction->None]\)[x] \!\(\*SuperscriptBox[\(h\), \(\[Prime]\),\nMultilineFunction->None]\)[S]+h[S] \!\(\*SuperscriptBox[\(g\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[x]+4 S g[x] \!\(\*SuperscriptBox[\(h\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[S]
}";

DerivativesExpression[parsedexpr_HoldComplete,  derivatives_List, {}, {keepDefs___Rule}] := Module[
	{result, rules, iparsed},
	
	iparsed = Module[
			{last = parsedexpr[[-1,-1]], iiexpr = parsedexpr, uniquehs = parsedexpr[[1,1]], derivativesOfFunction},
			derivativesOfFunction = d[last, Sequence@@#]&/@derivatives;
			iiexpr[[-1,-1]] = Sequence[clear@@uniquehs, derivativesOfFunction];
			
			iiexpr//.{clear->iClear, d->D}
		]; 
	
	result = $Block@@iparsed;
	
	(*Implement the definitions, if there are any:*)
	rules = Dispatch@(Reverse/@{keepDefs});
	result = result//.rules;
	
	result
]

(*DerivativesExpression[expr_, derivatives_List, {kernels_Integer}, {keepDefs___Rule}]/;Positive[kernels] := Module[
	{result, rules},
	LaunchKernels@@{kernels};
	result = ParallelMap[D[expr, Sequence@@#]&, derivatives, Method->"CoarsestGrained"];
	CloseKernels[];
	
	(*Implement the definitions, if there are any:*)
	rules = Dispatch@(Reverse/@{keepDefs});
	result//.rules
]*)

DerivativesExpression[x___] := Throw[$Failed, failTag[DerivativeExpression]]


Parser::usage="Parser[expr_]/;(Head@Unevaluated[expr]===$Block)
expr_: $Block[{{heads___}, otherVars___}, defs___]
Output: Same expression with $Block -> HoldComplete and {heads___} -> unique versions of the heads.
Example:
Parser[
	$Block[
		{{h1,h2}},
		h1[x_] = x+2;
		h2[x_] = x+3;
		h1[h2[x]]
	]
]
>>>HoldComplete[
	{{h11,h12}},
	h11[x_]=x+2;
	h12[x_]=x+3;
	h11[h12[x]]
]";

Attributes[Parser] = {HoldFirst};

Parser[expr_]/; (Head@Unevaluated[expr]===$Block) := Module[
	{iexpr, hs, uniquehs},
	(*Make the iexpr with HoldComplete*)
	iexpr = HoldComplete@@(Unevaluated@expr);
		
	(*Get Hold[h1,h2,h3,...]*)
	hs = (Hold@@@Extract[iexpr, {1,1}, Hold])//Flatten;
		
	(*Get: {HoldPattern[h1], HoldPattern[h2], ...}*)
	hs = List@@(HoldPattern/@hs);
		
	(*Make unique heads:*)
	uniquehs = Unique@("h"&/@Range[Length@hs]);
	(*Echo[(Thread[Rule[hs, uniquehs]])];*)
	(*change {h1, h2,...} in iexpr by {h1$nnn, h2$nnn,...}*)
	iexpr//.(Thread[Rule[hs, uniquehs]])
]

Parser[x___] := Throw[$Failed, failTag[Parser]]


iFunctionOccurrences::usage="iFunctionOccurrences[ExplicitDs, head]
ExplicitDs_List: List of explicit Derivative Functions;
head_Symbol: head appearing in \"ExplicitDs\"
Output: List of all occurrences of h and its derivatives in \"ExplicitDs\"
Example:

>>>Block[\[IndentingNewLine]	{list},
	list = {
		
		D[F[g[h[x]]], x], 
		
		D[F[g[h[x]]],{x,2}], 
		
		D[F[ g[h[x]], h[x], g[x] ], {x,3}], 
		D[F[h[x]], x, x]
	};
	
	iFunctionOccurrences[list, g]\[IndentingNewLine]]
>>> {g[h[x]],g[x],g'[h[x]],g''[h[x]],g'''[x],g'''[h[x]],g''[x],g'[x]}";

iFunctionOccurrences[ExplicitDs_List, head_Symbol] := Module[
	{hs, Ds, args, n},
	
	hs = Cases[ExplicitDs, head[args__], Infinity]//DeleteDuplicates;
	Ds = Cases[ExplicitDs, Derivative[n__][head][args__], Infinity]//DeleteDuplicates;
	
	Join[hs,Ds]
]

iFunctionOccurrences[x___] := Throw[$Failed, failTag[iFunctionOccurrences]]


MaxDepth::usage="MaxDepth[expr, h]
expr_: symbolic expression
h_Symbol: head for which you want the depths
Output: Finds the maximum depth of occurrences of \"h\" in \"expr\". Depth is calculated as the Lenght of all Position 
vectors indicating the position of \"h\" in \"expr\".
Obs.: For expressions involving derivatives is necessary to apply
	Derivative[n__][s_][args__]/;{args}[[1,0]] =!= List :> Derivative[n__][s_][{args__}]
to \"expr\" before MaxDepth, so that arguments of the function are in a higher Depth than \"s\" itself

Example:
>>>Block[
	{list},
	list = {D[F[g[h[x]]], x], D[F[g[h[x]]], {x,2}]}//.Derivative[n__][s_][args__]/;{args}[[1,0]] =!= List :> Derivative[n][s][{args}];

	{MaxDepth[list, F], MaxDepth[list, g], MaxDepth[list, h]}
]
>>>{
	{3,4},
	{4,5},
	{5,6}

}";

Attributes[MaxDepth] = Listable;

MaxDepth[expr_, h_] := Module[
	{positions, depths},
	
	positions = Position[expr, h, Infinity];
	
	
	
	If[
		Max@depths == - \[Infinity],
		0,
		Max@depths
	]
]

MaxDepth[x___] := Throw[$Failed, failTag[MaxDepth]]


FunctionOccurrences::usage="FunctionOccurrences[ExplicitDs, heads]
ExplicitDs_List: list of symbolic derivatives involving implicit functions;
heads_List: list of heads appearing in \"ExplicitDs\"
Output: List of all occurrences of the functions specified in \"heads\" including their derivatives, from the innermost
to the outtermost function, and a list of the corresponding heads in the order they appear.

Example:
>>>Block[\[IndentingNewLine]	{list},
	list = {
		D[F[g[h[x]]], x], 
		D[F[g[h[x]]],{x,2}]
	};
	
	FunctionOccurrences[list, {g, h, F}]\[IndentingNewLine]]
>>>{
	{
		{h[x],\!\(\*SuperscriptBox[\(h\), \(\[Prime]\),\nMultilineFunction->None]\)[x],\!\(\*SuperscriptBox[\(h\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[x]},
		{g[h[x]],\!\(\*SuperscriptBox[\(g\), \(\[Prime]\),\nMultilineFunction->None]\)[h[x]],\!\(\*SuperscriptBox[\(g\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[h[x]]},
		{\!\(\*SuperscriptBox[\(F\), \(\[Prime]\),\nMultilineFunction->None]\)[g[h[x]]],\!\(\*SuperscriptBox[\(F\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[g[h[x]]]}
	},
	{h,g,F}
}";

FunctionOccurrences[ExplicitDs_List, uniqueheads_List] := Module[
	{iExplicitDs, HeadDepth, iuniqueheads, result},
	
	(*Make an internal List of D's that puts f and g in different levels (as calculated by MaxDepth) in f'[g[x]]*)
	iExplicitDs = ExplicitDs//.Derivative[n__][s_][args__]/;{args}[[1,0]] =!= List :> Derivative[n][s][{args}];
	
	(*Calculate the Depth of everyone:*)
	(HeadDepth[#] = Max[MaxDepth[iExplicitDs, #]])&/@uniqueheads;
	
	(*Organize the heads from the innermost to the outermost:*)
	iuniqueheads = ReverseSortBy[uniqueheads, HeadDepth];
		
	result = iFunctionOccurrences[ExplicitDs, #]&/@iuniqueheads;
	
	{result, iuniqueheads}
]

FunctionOccurrences[x___] := Throw[$Failed, failTag[FunctionOccurrences]]


Attributes[iClear] = {HoldAll};
Attributes[ifDV] = {HoldAll};
Attributes[ifOV] = {HoldAll};
ifDV[x_] := DownValues[x] = {};
ifOV[x_] := OwnValues[x] = {};

iClear[x__] := With[
	{}, 
	List@@(ifDV/@Hold[x]); List@@(ifOV/@Hold[x]);
	Nothing
]


UniqueVars::usage="UniqueVars[expr, functions, heads, {defs}]
expr_HoldComplete: parsed $Block expression, with respect to which one is taking derivatives;
functions_List: list of functions and function derivatives that appear in the derivatives of \"expr\";
heads_List: list of heads appearing in \"functions\" in the order that they appear;
{defs___Rule}: variable definitions that one wants to keep.
Output: Association containg 2 lists of rules. 
-> List1: $xi variables and their explicit definition. 
-> List2: $xi variables and their correspondence to implicit functions appearing in \"functions\".
Example:

Module[
	{expr, functions, heads},
	expr = HoldComplete[
		{{h1,h2,h3}},
		h1[x_] = 3 \!\(\*SuperscriptBox[\(x\), \(2\)]\); h2[x_] = Sin[x]; h3[x_] = Cosh[x];
		h1[h2[x]] h3[x]
	];

	{functions, heads} = FunctionOccurrences[{D[h1[h2[x]] h3[x], x], D[h1[h2[x]] h3[x],x,x]}, {h1,h2,h3}];

	UniqueVars[expr, functions, heads, {}]
]
>>>\[LeftAssociation]
	\"x$DEF\"\[Rule]{$x1\[Rule]Sin[x],$x2\[Rule]Cos[x],$x3\[Rule]-Sin[x],$x4\[Rule]Cosh[x],$x5\[Rule]Sinh[x],$x6\[Rule]Cosh[x],$x7\[Rule]3 \!\(\*SuperscriptBox[\($x1\), \(2\)]\),$x8\[Rule]6 $x1,$x9\[Rule]6},
	\"x$Correspondence\"\[Rule]{\!\(\*SuperscriptBox[\(h1\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[h2[x]]\[Rule]$x9,\!\(\*SuperscriptBox[\(h1\), \(\[Prime]\),\nMultilineFunction->None]\)[h2[x]]\[Rule]$x8,h1[h2[x]]\[Rule]$x7,\!\(\*SuperscriptBox[\(h3\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[x]\[Rule]$x6,\!\(\*SuperscriptBox[\(h3\), \(\[Prime]\),\nMultilineFunction->None]\)[x]\[Rule]$x5,h3[x]\[Rule]$x4,\!\(\*SuperscriptBox[\(h2\), \(\[Prime]\[Prime]\),\nMultilineFunction->None]\)[x]\[Rule]$x3,\!\(\*SuperscriptBox[\(h2\), \(\[Prime]\),\nMultilineFunction->None]\)[x]\[Rule]$x2,h2[x]\[Rule]$x1}
\[RightAssociation]";

UniqueVars[expr_HoldComplete, functions_List, heads_List, {defs___Rule}] := Module[
	{ifunctions, idefs, $iiexpr = expr, list1, vars, list2},
	
	(*Make the function list to insert in the last term of expr*)
	ifunctions = Riffle[functions, iclear/@heads]//Flatten;
	(*List of all variables whose defs you want to keep:*)
	idefs = {defs}[[All,1]];
	(*Clear them before evaluation:*)
	$iiexpr[[-1,-1]] = Sequence[iclear@@idefs, ifunctions]; 
	
	(*Calculate the explicit definitions*)
	list1 = $Block@@($iiexpr//.iclear->iClear);
	
	(*Make the vars x$nnn*)
	vars = Symbol["$x" <> ToString[#]]&/@Range[Length@Flatten[functions]];
	
	(*make x$nnn -> explicit def*)
	list1 = Thread@Rule[vars, list1];
	
	(*Now make the list implicitdef -> x$nnn*)
	list2 = Thread@Rule[Flatten[functions], vars];
	
	(*Now, reverse the order, so that expressions with big depth appear first:*)
	list2 = Reverse[list2]; 
	
	(*eliminate things like Cos[h[x]] from explicit defs, assuming the implicit def is g[h[x]] and g[x_] = Cos[x]*)
	list1 = list1//.list2;
	
	<|"x$DEF" -> list1, "x$Correspondence" -> list2|>
]

UniqueVars[x___] := Throw[$Failed, failTag[UniqueVars]]


AbreviatedExpressions::usage="AbreviatedExpressions[expr, dexpressions, {defs}]
expr_HoldComplete: parsed $Block expression;
dexpressions_List: list of all implicit derivatives of \"expr\";
defs___Rule: variables you want to keep the definitions.
Output: list of 2 lists
-> list1: the derivative expressions in \"dexpressions\" with implicit functions replaced by $xi variables;
-> list2: list of rules that define the $xi variables explicitly.

Example:
>>>Module[
	{expr, dexpressions},
	expr = HoldComplete[
		{{h1,h2,h3}},
		h1[x_] = 3 \!\(\*SuperscriptBox[\(x\), \(2\)]\); h2[x_] = Sin[x]; h3[x_] = Cosh[x];
		h1[h2[x]] h3[x]
	];

	dexpressions = {h1[h2[x]] h3[x], D[h1[h2[x]] h3[x], x], D[h1[h2[x]] h3[x],x,x]};

	AbreviatedExpressions[expr, dexpressions, {}]
]
>>>{
	{$x4 $x7,$x5 $x7+$x2 $x4 $x8,$x6 $x7+$x3 $x4 $x8+2 $x2 $x5 $x8+\!\(\*SuperscriptBox[\($x2\), \(2\)]\) $x4 $x9},
	
	{$x1\[Rule]Sin[x],$x2\[Rule]Cos[x],$x3\[Rule]-Sin[x],$x4\[Rule]Cosh[x],$x5\[Rule]Sinh[x],$x6\[Rule]Cosh[x],$x7\[Rule]3 \!\(\*SuperscriptBox[\($x1\), \(2\)]\),$x8\[Rule]6 $x1,$x9\[Rule]6}
}";

AbreviatedExpressions[expr_HoldComplete, dexpressions_List, {defs___Rule}] := Module[
	{uniquehs = expr[[1,1]], functions, heads, association, idexpressions},
	
	(*all functions and function derivatives, and an association to indicate how many terms each head has*)
	{functions, heads} = FunctionOccurrences[Flatten[dexpressions], uniquehs];
	
	
	(*Make the explicit defs of Unique variables and their correspondence to implicit functions*)
	association = UniqueVars[expr, functions, heads, {defs}];
	idexpressions = dexpressions//.association["x$Correspondence"];
	
	
	(*Return the derivative expressions with unique vars and their correspondence to explicit functions*)
	{
		idexpressions,
		association["x$DEF"]
	}
]

AbreviatedExpressions[x___] := Throw[$Failed, failTag[AbreviatedExpressions]]


(*NEW WAY OF CALCULATING DERIVATIVES OF COMPOSITE FUNCTIONS #############################################################################################################*)

FindFunctionHead[expr_]/; expr[[0,0]] === Symbol := expr[[0]]
FindFunctionHead[expr_]/; expr[[0,0,0]] === Derivative := expr[[0,1]]

CalculateFunctionDef[exprMain_HoldComplete, {}, uniquehs_List, {defs___Rule}] := {}

CalculateFunctionDef[exprMain_HoldComplete, ioccurrences_List, uniquehs_List, {defs___Rule}]/;ioccurrences =!={} := Module[
	{relevantHeads, dummy},
	
	relevantHeads = FindFunctionHead/@ioccurrences;

	
	dummy[normalexpr_, function_] := Module[
		{iexpr = exprMain, clearHeads = DeleteElements[uniquehs, {function}], iclear},
		iexpr[[-1,-1]] = Sequence[iclear@@Join[clearHeads, {defs}[[All,1]]], normalexpr];
		iclear=iClear;
		$Block@@iexpr
	]; 

	dummy@@@MapThread[List, {ioccurrences, relevantHeads}]
]

CalculateFunctionDef[x___] := Throw[$Failed, failTag[CalculateFunctionDef]]

uniqueVarFunction[0] := {};

uniqueVarFunction[length_Integer]/;length > 0 := Module[
	{max$x = StringReplace[Names["Global`$x*"], "$x" -> ""]//ToExpression//Max},
	
	If[
		max$x === -\[Infinity], 
		"$x"<>#&/@(ToString/@Range[1, length])//ToExpression,
		"$x"<>#&/@(ToString/@Range[max$x+1,max$x+length])//ToExpression
	]
]

uniqueVarFunction[x___] := Throw[$Failed, failTag[uniqueVarFunction]]

PoolUpdate[exprMain_HoldComplete, {}, {pool1_DataStructure, pool2_DataStructure}, uniquehs_List, {defs___Rule}] := Null

PoolUpdate[exprMain_HoldComplete, occurrences_List, {pool1_DataStructure, pool2_DataStructure}, uniquehs_List, {defs___Rule}]/;occurrences =!={} := Module[
	{existingKeys, ioccurrences, functionDefs, $xList, numberPos, Nexs, Numbers, ioccurrencescopy},
	
	existingKeys = Position[pool1["KeyExistsQ", #]&/@occurrences, True]; (*Position of all functions already calculated*)
	
	ioccurrences = Delete[occurrences, existingKeys]//DeleteDuplicates;
	
	(*Take the normal expressions and replace h_[x_] by existing $xj*)
	ioccurrencescopy =  ioccurrences//.pool1["Elements"];
	
	functionDefs = CalculateFunctionDef[exprMain, ioccurrencescopy, uniquehs, {defs}];
	
	(*YOU SHOULD DO THE REPLACEMENT BELOW BEFORE CALCULATING THE FUNCTION DEFS
	Take the function defs and replace h_[x_] by existing $xj*)
	(*functionDefs = EchoTiming[functionDefs//.pool1["Elements"], "Rule application"];*)
	
	(*Make rules for NE -> number when numbers are found:*)
	numberPos = Position[functionDefs, _?NumberQ, {1}];
	Nexs = Extract[ioccurrences, numberPos];
	Numbers = Extract[functionDefs, numberPos];
	pool1["Insert", #]&/@(MapThread[Rule, {Nexs,Numbers}]);
	
	(*Delete these normal expressions and their defs from the lists:*)
	ioccurrences = Delete[ioccurrences, numberPos];
	functionDefs = Delete[functionDefs, numberPos];
	
	(*Apply the rules from KeepDefs to explicit expressions:*)
	With[
		{irules = Reverse/@{defs}}, 
		functionDefs = functionDefs//.irules;
		
	];
	
	$xList = uniqueVarFunction[Length[ioccurrences]];
	
	pool1["Insert", #]&/@(MapThread[Rule, {ioccurrences, $xList}]);
	
	
	pool2["Insert", #]&/@(MapThread[Rule, {$xList, functionDefs}]);
]

PoolUpdate[x___] := Throw[$Failed, failTag[PoolUpdate]]

iIncludeFunctionDef[exprMain_HoldComplete, expr_, depth_Integer, uniquehs_List, {pool1_DataStructure, pool2_DataStructure}, {defs___Rule}] := Module[
	{headsPattern, DPattern, occurrences},
	
	headsPattern = #[x__]&/@uniquehs; 
	DPattern = Derivative[n__][#][y__]&/@uniquehs;
	
	occurrences = Cases[expr, Alternatives@@Join[headsPattern, DPattern], {depth}]//DeleteDuplicates;
	
	PoolUpdate[exprMain, occurrences, {pool1, pool2}, uniquehs, {defs}];
]

iIncludeFunctionDef[x___] := Throw[$Failed, faiTag[iIncludeFunctionDef]]

IncludeFunctionDef[exprMain_HoldComplete, expr_, uniquehs_List, {pool1_DataStructure, pool2_DataStructure}, {defs___Rule}] :=Module[
	{depths = Range[Depth[expr], 0, -1]},
	
	iIncludeFunctionDef[exprMain, expr, #, uniquehs, {pool1, pool2}, {defs}]&/@depths;
]

IncludeFunctionDef[x___] := Throw[$Failed, failTag[IncludeFunctionDef]]

GetAllDefs[exprMain_HoldComplete, implicitDs_List, uniquehs_List, {defs___Rule}] := Module[
	{pool1 = CreateDataStructure["HashTable"], pool2 = CreateDataStructure["HashTable"], iImplicitDs},
	
	(*Quiet[Remove["Global`$x*"], Remove::rmnsm];*) ClearAll["Global`$x*"];
	
	IncludeFunctionDef[exprMain, #, uniquehs, {pool1, pool2}, {defs}]&/@implicitDs;
	
	
	
	iImplicitDs = implicitDs//.pool1["Elements"]; (*Echo[pool2["Elements"]];*)
	{
		iImplicitDs,
		pool2["Elements"]
	}
]

GetAllDefs[x___] := Throw[$Failed, failTag[GetAllDefs]]

