(*
	DExpression: derivative expression with depending on the xn's as defined in AbreviatedExpressions.
	For instance $x1 +$x2 $x3 x
	{symbols__}: all the $xn that appear in DExpression
	pool: Association with the explicit definition of the $xn's, for instance <|$x1 -> x^2, $x2-> Sin[x], $x3 -> y,... |>
	
	Output: Block function wrapped in HoldForm to calculate the derivative. For the defs above it would be:
		HoldForm@Block[
			{$x1,$x2,$x3},
			$x1 = x^2; 
			$x2 = Sin[x];
			$x3 = y;
			$x1 + $x2 $x3 x
	]

*)

DFunction[x_?NumberQ, {} , pool_Association, {defs___Rule}] := x

DFunction[DExpression_, {symbols__Symbol}, pool_Association, {defs___Rule}] := Module[
	{setdefs, compound, vars, expr, setdefsivars},
	
	(*make a sequence of defs $x1 = x^2 and so on, and definitions for the internal variables like a = x-y, ...*)
	setdefs = HoldComplete@@(Thread@set[{symbols},  pool/@{symbols}]);
	setdefsivars = HoldComplete@@(set@@@{defs});
	setdefs = Join[setdefsivars, setdefs];
	setdefs = Set@@@setdefs;
	
	(*make a compound expression for Block:*)
	compound = HoldComplete@@{Join[setdefs, HoldComplete[DExpression]]};
	compound = CompoundExpression@@@compound;
	
	(*declare the variables $x and internal variables from keep defs:*)
	vars = With[
		{ivars = {symbols}, iivars = {defs}[[All,1]]},
		HoldComplete[x]/. x-> Join[ivars, iivars]
	];
	
	(*make the expression:*)
	expr = Join[vars, compound];
	Block@@@(HoldForm[Evaluate@expr])
]

DFunction[x___] := Throw[$Failed, failTag[DFunction]]


iDependencySearch::usage="iDependencySearch[$xiList, $xiDefs]
$xiList_List: list of $xi vars;
$xiDefs_List: list of rules containig the defs of $xi;
Output: set of vars $xj on which the $xi in \"$xiList\" depend upon.

Example:
>>>Block[
	{$xiList, $xiDefs},

	$xiList = {$x2, $x5, $x6};
	
	$xiDefs = {
		$x1 -> Sin[x],
		$x2 -> Cos[x],
		$x3 -> Exp[$x1],
		$x4 -> 1 + Cos[x] \!\(\*SuperscriptBox[\($x3\), \(2\)]\),
		$x5 -> 1 - Sin[$x1] $x2,
		$x6 -> 1+ Exp[x] Cosh[a] Sin[2+ $x4]
	};
	iDependencySearch[$xiList, $xiDefs]
]
>>>{$x2,$x1,$x4}
";

iDependencySearch[primaryList_, $xiDefs_List] := Module[
	{ivars = $xiDefs[[All,1]]},
	
	Cases[primaryList/.$xiDefs, Alternatives@@ivars, Infinity]//DeleteDuplicates
]

iDependencySearch[x___] := Throw[$Failed, failTag[iDependencySearch]]


DependencySearch::usage="DependencySearch[expr, $xiDefs]
expr: derivative expression with implicit functions replaced by $xi;
$xiDefs_List: list of rules giving explicit definitions of the $xi variables.
Output: all symbols $xi you need to define so that you  can calculate the expression \"expr\".

Example:
>>>Block[
	{expr, $xiDefs},

	expr = Sin[$x6] Exp[I $x2] + Cos[$x3];
	
	$xiDefs = {
		$x1 -> Sin[x],
		$x2 -> Cos[x],
		$x3 -> Exp[$x1],
		$x4 -> 1 + Cos[x] \!\(\*SuperscriptBox[\($x3\), \(2\)]\),
		$x5 -> 1 - Sin[$x1] $x2,
		$x6 -> 1+ Exp[x] Cosh[a] Sin[2+ $x4]
	};

	DependencySearch[expr, $xiDefs]
]
>>> {$x1,$x2,$x3,$x4,$x6}
";

DependencySearch[expr_, $xiDefs_List] := Module[
	{ivars = $xiDefs[[All,1]], firstList, result},
	
	firstList = Cases[If[AtomQ[expr], {expr}, expr], Alternatives@@ivars, Infinity]//DeleteDuplicates; 
	
	result = FixedPointList[
		iDependencySearch[#, $xiDefs]&, 
		firstList
	];
	
	SortBy[ToExpression[StringReplace[ToString[#], "$x"->""]]&]@(Flatten[result]//DeleteDuplicates)
]

DependencySearch[x___] := Throw[$Failed, failTag[DependencySearch]]


AuxiliarFunctions::usage="AuxiliarFunctions[expr, derivativeVars, {parallel}, {defs}]
expr_: Function definition with respect to which you are going to take derivatives;
derivativesVars_List: list of derivatives you want to take;
parallel___Integer: number of kernels to launch to calculate the derivatives;
defs___Rule: variable definitions you want to keep;
Output: list of function derivatives";

Attributes[AuxiliarFunctions] = HoldFirst;

AuxiliarFunctions[expr_, derivativesVars_List, {parallel___Integer}, {defs___Rule}]/;(
	(Head@Unevaluated[expr]) =!= $Block
) := Module[
	{derivativesList},
	
	If[
		{parallel} === {},
		derivativesList = D[expr, Sequence@@#]&/@derivativesVars;,
		LaunchKernels@@{parallel};
		derivativesList = ParallelMap[D[expr, Sequence@@#]&, derivativesVars];
		CloseKernels[];
	];
	
	derivativesList
]

AuxiliarFunctions[expr_, derivativeVars_List, {parallel___Integer}, {defs___Rule}]/;(Head@Unevaluated[expr] == $Block) := Module[
	{iexpr,explicit, derivatives, dictionary, symbols, functions, numberPos},
		
		(*Get the parsed expression:*)
		
		iexpr = Parser[expr]; 
		
		(*Get all derivatives in terms of implicit functions*)
		derivatives =  EchoTiming[
			DerivativesExpression[iexpr, derivativeVars, {parallel}, {defs}], 
			"symbolic Derivatives:"
		];
		
		(*all function derivatives with f'[x] -> $xn and a dictionary for $xn -> explicit expression*)
		(*{derivatives, dictionary} = EchoTiming[AbreviatedExpressions[iexpr, derivatives, {defs}], "sym derivatives -> $x and explicit derivatives: "];*)
		{derivatives, dictionary} = GetAllDefs[iexpr, derivatives, iexpr[[1,1]], {defs}];
		
		
		(*(Get all symbols in each expression:)*)
		symbols = DependencySearch[#, dictionary]&/@derivatives;
		(*Echo[{derivatives, dictionary}];*)(*Echo[{symbols, derivatives, dictionary}];*)
		(*(make the functions:)*)
		functions = EchoTiming[
			MapThread[
				DFunction[#1, #2, Association@dictionary, {defs}]&,
				{derivatives, symbols}
			], 
			"Make Block functions: "
		];
		
		(*(Remove the unique heads previously generated)*)
		Remove@@(iexpr[[1,1]]);
		Clear[iexpr];
		
		functions
]

AuxiliarFunctions[args___] := Throw[$Failed, failTag[AuxiliarFunctions]]


(*Block[
	{$xiList, $xiDefs},

	$xiList = {$x2, $x5, $x6};
	
	$xiDefs = {
		$x1 -> Sin[x],
		$x2 -> Cos[x],
		$x3 -> Exp[$x1],
		$x4 -> 1 + Cos[x] $x3^2,
		$x5 -> 1 - Sin[$x1] $x2,
		$x6 -> 1+ Exp[x] Cosh[a] Sin[2+ $x4]
	};

	iDependencySearch[$xiList, $xiDefs]
]*)


(*
	name: symbol without definition to be used as function name
	vars: variables of the function, for instance {x}
	derivativeVars: list of all required derivatives, for instance {{}, {x}, ...}
	functions: corresponding list of all functions obtained by taking the derivatives, for instance {x^2, 2x, ...}
	
	Output: List of rules of the type {
		name[x_] -> x^2,
		$D[{1}, name][x_] -> 2 x
		...
	}
	

*)

iDerivativeRules[name_Symbol, vars_List, derivativeVars_List, functions_List, zeroD_?BooleanQ] := Module[
	
	{derivativeHeadList, RulesList, patternVars, patternDerivativeVars, rule, nonzeroCases, numberCases, trivialRules},
	
	patternVars = Pattern[#, Blank[]]&/@vars;
	
	patternDerivativeVars = If[
		zeroD,
		Map[
			Pattern[#, Blank[]]&,
			Drop[derivativeVars,1],
			{2}
		],
		Map[
			Pattern[#, Blank[]]&,
			derivativeVars,
			{2}
		]
	];
	
	(*Include 0 derivative head if necessary*)
	derivativeHeadList = If[
		zeroD,
		Prepend[D[name@@patternVars, Sequence@@#]&/@patternDerivativeVars,  name@@patternVars],
		D[name@@patternVars, Sequence@@#]&/@patternDerivativeVars
	];
	
	derivativeHeadList = Replace[
		derivativeHeadList,
		Derivative[x__][y_Symbol][k__] -> $D[{x}, y][k],
		{1}
	];
	
	
	(*Now, finally construct the list of Rules*)
	RulesList = MapThread[
		(#1  -> #2)&,
		{derivativeHeadList, functions}
	];
	
	RulesList
]

iDerivativeRules[args___] := Throw[$Failed, failTag[iDerivativeRules]]


DerivativeRules::fail="The function failed. The failure occured in function `1`";


Attributes[DerivativeRules] = HoldRest;

Options[DerivativeRules] = {"IncludeZeroDerivative" -> True, Assumptions -> $Assumptions, TimeConstraint->300, 
	"Parallel" -> {}, "KeepDefs" -> {}};

(*HOW CAN I CONSTRAIN THIS OPTION TO BE EITHER TRUE OR FALSE?*)
DerivativeRules[{name_, vars_, n_Integer}, expr_, OptionsPattern[]]/;(
	genErrorMessage@(
		Comap[{OwnValues, UpValues, SubValues, FormatValues, NValues, DownValues}, name] === ConstantArray[{}, 6]
	) &&
	genErrorMessage@(Head/@{name, vars, n} === {Symbol, List, Integer}) &&
	
	genErrorMessage@(Head/@vars === ConstantArray[Symbol, Length@vars] && n>0) &&
	
	genErrorMessage@(Comap[{OwnValues, DownValues, SubValues, UpValues}, name] === {{},{},{},{}})
	
) := Module[

	{listOfDerivatives, listOfFunctions, listOfRules, zeroCases, trivialRules},
	
	Catch[
		listOfDerivatives = DerivativeCombinations[vars, n, OptionValue[DerivativeRules, "IncludeZeroDerivative"]];
		
		listOfFunctions = AuxiliarFunctions[
			expr, 
			listOfDerivatives,
			OptionValue[DerivativeRules, "Parallel"],
			OptionValue[DerivativeRules, "KeepDefs"]
		];
		
		listOfRules = iDerivativeRules[name, vars, listOfDerivatives, listOfFunctions, OptionValue[DerivativeRules, "IncludeZeroDerivative"] ];
		listOfRules,
		_failTag,
		(Message[DerivativeRules::fail, Style[First@#2, Red]]; #1) &
	]
]


DerivativeRules[{name_, vars_, derivatives_List}, expr_, OptionsPattern[]]/;(
	genErrorMessage@(Comap[{OwnValues, DownValues, SubValues, UpValues}, name] === {{},{},{},{}})
) := Module[

	{listOfDerivatives, listOfFunctions, listOfRules, zeroCases, trivialRules},
	
	Catch[
		listOfDerivatives = derivatives;
		listOfFunctions = AuxiliarFunctions[
			expr, 
			listOfDerivatives,
			OptionValue[DerivativeRules, "Parallel"],
			OptionValue[DerivativeRules, "KeepDefs"]
		];
		
		listOfRules = iDerivativeRules[name, vars, listOfDerivatives, listOfFunctions, OptionValue[DerivativeRules, "IncludeZeroDerivative"] ];
		listOfRules,
		_failTag,
		(Message[DerivativeRules::fail, Style[First@#2, Red]]; #1) &
	]
]


