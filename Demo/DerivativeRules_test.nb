Cell[BoxData[
 RowBox[{
  RowBox[{"FuncsFromRules", "[", 
   RowBox[{"rules_List", ",", " ", "head_String"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"hs", ",", " ", "newRulesHeads"}], "}"}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"hs", " ", "=", " ", 
      RowBox[{"Unique", "@", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"head", ",", " ", 
         RowBox[{"Length", "@", "rules"}]}], "]"}]}]}], ";", "\n", "\t", "\n",
      "\t", 
     RowBox[{"newRulesHeads", " ", "=", " ", 
      RowBox[{"MapThread", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{
         RowBox[{"#1", "@@", "#2"}], "&"}], ",", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"hs", ",", " ", 
          RowBox[{"rules", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], "}"}]}], "\n", 
       "\t", "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"MapThread", "[", "\n", "\t ", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#1", " ", "=", " ", "#2"}], ")"}], "&"}], ",", "\n", "\t ", 
       
       RowBox[{"{", 
        RowBox[{"newRulesHeads", ",", " ", 
         RowBox[{"rules", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "\n", "\t", 
      "]"}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"Map", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"DownValues", "[", "#1", "]"}], " ", "=", " ", 
          RowBox[{"Replace", "[", 
           RowBox[{
            RowBox[{"DownValues", "[", "#1", "]"}], ",", " ", 
            RowBox[{
             RowBox[{"HoldForm", "[", "x_", "]"}], " ", ":>", " ", "x"}], ",",
             " ", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ")"}], "&"}], ",", "\n", 
       "\t\t", "hs"}], "\n", "\t", "]"}], ";", "\n", "\t", "\n", "\t", 
