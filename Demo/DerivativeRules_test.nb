 RowBox[{
  RowBox[{
   RowBox[{"TestConsistency", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", "vars__", "}"}], ",", "  ", "n_Integer"}], "}"}], ",", 
     "  ", "expr_", ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], "/;", 
   RowBox[{"(", "\n", "\t", 
    RowBox[{
     RowBox[{"Head", "@", 
      RowBox[{"Unevaluated", "[", "expr", "]"}]}], " ", "===", " ", 
     "$Block"}], "\n", ")"}]}], " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "flath", ",", " ", "dummy", ",", " ", "flatRules", ",", " ", "rules", ",",
       " ", "flatHeads", ",", " ", "$BlockHeads", ",", " ", 
      RowBox[{"len", " ", "=", " ", 
       RowBox[{"Length", "[", 
        RowBox[{"{", "vars", "}"}], "]"}]}], ",", " ", "vec", ",", " ", 
      RowBox[{"opts", " ", "=", " ", 
       RowBox[{
        RowBox[{"Options", "[", "DerivativeRules", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], " ", "}"}], ",", "\n", 
    "\t", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Inactive", "[", "Set", "]"}], "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"flath", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Pattern", "[", 
             RowBox[{"#", ",", 
              RowBox[{"Blank", "[", "]"}]}], "]"}], "&"}], "/@", 
           RowBox[{"{", "vars", "}"}]}], ")"}]}], ",", "\n", "\t\t", "expr"}],
        "\n", "\t", "]"}], "//", "Activate"}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"flatRules", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"DerivativeRules", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dummy", ",", " ", 
           RowBox[{"{", "vars", "}"}], ",", " ", "n"}], "}"}], ",", "\n", 
         "\t\t", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"flath", "@@", 
           RowBox[{"{", "vars", "}"}]}], "]"}]}], "\n", "\t", "]"}], ")"}]}], 
     ";", "\n", "\t", "\n", "\t", 
     RowBox[{"rules", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"DerivativeRules", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"dummy", ",", " ", 
           RowBox[{"{", "vars", "}"}], ",", " ", "n"}], "}"}], ",", "\n", 
         "\t\t", "expr", ",", " ", "\n", "\t\t", 
         RowBox[{"Evaluate", "[", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"MapThread", "[", "\n", "\t\t\t", 
            RowBox[{"Rule", ",", "\n", "\t\t\t", 
             RowBox[{"{", 
              RowBox[{"opts", ",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"OptionValue", "[", 
                  RowBox[{"TestConsistency", ",", " ", "#"}], "]"}], "&"}], "/@",
                 "opts"}]}], "}"}]}], "\n", "\t\t", "]"}]}], "]"}]}], "\n", 
        "\t", "]"}], ")"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"flatHeads", " ", "=", "  ", 
      RowBox[{"FuncsFromRules", "[", 
       RowBox[{"flatRules", ",", "  ", "\"\<flath\>\""}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"$BlockHeads", " ", "=", " ", 
      RowBox[{"FuncsFromRules", "[", 
       RowBox[{"rules", ",", " ", "\"\<h\>\""}], "]"}]}], ";", "\n", "\t", 
     "\n", "\t", 
     RowBox[{"vec", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "100"}], "}"}], ",", " ", "len"}], "]"}]}], ";", 
     "\n", "\t", 
     RowBox[{"WithCleanup", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ComapApply", "[", 
           RowBox[{"flatHeads", ",", " ", "vec"}], "]"}], ",", " ", 
          RowBox[{"ComapApply", "[", 
           RowBox[{"$BlockHeads", ",", " ", "vec"}], "]"}]}], "}"}]}], ",", 
       "\n", "\t", 
       RowBox[{"Clear", "@@", 
        RowBox[{"Join", "[", 
         RowBox[{"flatHeads", ",", " ", "$BlockHeads"}], "]"}]}]}], "\t", 
      "\n", "\t", "]"}]}]}], "\n", "]"}]}]}], "Code",
