Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"DerivativeRules", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", " ", "5"}], "}"}], ",", "\n", 
     "\t", 
     RowBox[{"$Block", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h1", ",", " ", "h2", ",", " ", "F"}], "}"}], ",", " ", "a",
          ",", " ", "b"}], "}"}], ",", "\n", "\t\t", "\n", "\t\t", 
       RowBox[{
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"x", "-", "y"}]}], ";", "\n", "\t\t", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"x", "+", "y"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
        RowBox[{
         RowBox[{"h1", "[", "b_", "]"}], " ", ":=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "b", "]"}], ",", " ", 
           RowBox[{"Cos", "[", "b", "]"}]}], "}"}]}], ";", "\n", "\t\t", 
        RowBox[{
         RowBox[{"h2", "[", "a_", "]"}], " ", ":=", " ", 
         SuperscriptBox[
          RowBox[{"Cosh", "[", 
           FractionBox["a", "100"], "]"}], "2"]}], ";", "\n", "\t\t", 
        RowBox[{
         RowBox[{"F", "[", 
          RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "]"}], " ", ":=", 
         " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           FractionBox[
            RowBox[{"a", "-", "b"}], "100"], "]"}], " ", "+", " ", "c"}]}], ";",
         "\n", "\t\t", "\n", "\t\t", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"h1", "[", 
           RowBox[{"a", " ", 
            RowBox[{"h2", "[", "b", "]"}]}], "]"}]}], " ", "+", " ", 
         RowBox[{"F", "[", 
          RowBox[{
           RowBox[{"h2", "[", 
            RowBox[{"h1", "[", "a", "]"}], "]"}], ",", " ", 
           RowBox[{"h1", "[", "b", "]"}], ",", " ", 
           RowBox[{"h2", "[", "b", "]"}]}], "]"}], " ", "+", " ", 
         RowBox[{"F", "[", 
          RowBox[{"a", ",", "x", ",", "y"}], "]"}]}]}]}], "\n", "\t", "]"}], ",",
      "\n", "\t", 
     RowBox[{"\"\<KeepDefs\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"a", "->", " ", 
         RowBox[{"x", "-", "y"}]}], ",", " ", 
        RowBox[{"b", "->", " ", 
         RowBox[{"x", "+", "y"}]}]}], "}"}]}]}], "\n", "]"}], "//", 
   "QuietEcho"}], ";"}]], "Code",
