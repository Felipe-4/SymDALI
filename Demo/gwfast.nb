Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", 
   " ", "\"\<\nimport matplotlib.pyplot as plt\nimport corner\nchain = \
np.array(<*chainR*>)\n\nflat =  chain_reduce(chain, 4000, 1000)\nfig = \
corner.corner(\n    flat,\n    \n     \n    levels = (0.68,0.954),\n    \n    \
quantiles=[0.16, 0.5, 0.84],\n    show_titles=True,\n    \
title_kwargs={\\\"fontsize\\\": 12},\n);\n\nplt.savefig('test.pdf')\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.9519000749508038`*^9, 3.951900139911421*^9}, {
