 RowBox[{
  RowBox[{
   RowBox[{"Attributes", "[", "RelativeDiff", "]"}], " ", "=", " ", 
   RowBox[{"{", "Listable", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RelativeDiff", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "/;", 
   RowBox[{
    RowBox[{"x", "==", "0"}], " ", "&&", 
    RowBox[{"y", "==", "0"}]}]}], " ", ":=", " ", "0"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RelativeDiff", "[", 
    RowBox[{"0", ",", " ", "y_"}], "]"}], "/;", " ", 
   RowBox[{"y", "!=", "0"}]}], " ", ":=", " ", "1"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RelativeDiff", "[", 
     RowBox[{"x_", ",", " ", "0"}], "]"}], "/;", " ", 
    RowBox[{"x", "!=", "0"}]}], " ", ":=", " ", "1"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RelativeDiff", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], "/;", " ", 
   RowBox[{
    RowBox[{"x", "!=", "0"}], " ", "&&", 
    RowBox[{"y", "!=", "0"}]}]}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{"x", "-", "y"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "@", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"diff", "/", "x"}], ",", " ", 
        RowBox[{"diff", "/", "y"}]}], "}"}]}], "]"}]}], "\n", 
   "]"}]}]}], "Code",
 CellLabel->"In[5]:=",ExpressionUUID->"0447e7d0-48ab-4017-ad69-2465f4d09b47"],

