= chain[burn:, :, :]\n\ta = a[::thin, :, :]\n\tnw, ns, d = a.shape\n\ta = \
a.reshape(nw*ns, d)\n\treturn a\n\>\""}], "]"}]], "Code",
 CellChangeTimes->{{3.9518999153674517`*^9, 3.9519000169057693`*^9}, {
  3.952093230636516*^9, 3.952093234132552*^9}},
