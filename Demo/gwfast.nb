 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", 
   "\"\<\ndef chain_reduce(chain, burn, thin):\n\ta = chain[burn:, :, :]\n\ta \
= a[::thin, :, :]\n\tnw, ns, d = a.shape\n\ta = a.reshape(nw*ns, d)\n\treturn \
a\n\>\""}], "]"}]], "Code",
