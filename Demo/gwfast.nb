Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<\nimport jax\nimport os\nimport sys\n\nimport copy\nimport numpy as \
onp\nfrom astropy.cosmology import Planck18\n\nPACKAGE_PARENT = '..'\n\
SCRIPT_DIR = os.path.dirname(os.path.realpath(os.path.join(os.getcwd())))\n\
sys.path.append(SCRIPT_DIR)\nimport gwfast.gwfastGlobals as glob\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.948372017815537*^9, 3.9483720490217733`*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"50d04d58-9c29-45ff-8614-b03420f4c274"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<\nalldetectors = copy.deepcopy(glob.detectors)\nprint('All available \
detectors are: '+str(list(alldetectors.keys())))\n\n# select only LIGO and \
Virgo\nLVdetectors = {det:alldetectors[det] for det in ['L1', 'H1', 'Virgo']}\
\nprint('Using detectors '+str(list(LVdetectors.keys())))\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.948372060814776*^9, 3.9483720729103327`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"595b7454-89a7-44af-8f34-697682c6e336"],

Cell[CellGroupData[{

Cell[BoxData["\<\"All available detectors are: ['L1', 'H1', 'Virgo', 'KAGRA', \
'LIGOI', 'ETS', 'ETMR', 'ETSL', 'ETMRL45d', 'ETMRLpar', 'CE1Id', 'CE2NM', \
'CE2NSW']\"\>"], "Print",
 CellChangeTimes->{3.948372073778946*^9, 3.948372327497253*^9},
 CellLabel->
