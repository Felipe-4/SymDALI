     RowBox[{"x_", ",", " ", "0"}], "]"}], "/;", " ", 
    RowBox[{"x", "!=", "0"}]}], " ", ":=", " ", "1"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RelativeDiff", "[", 
