Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<\nfrom gwfastUtils import GPSt_to_LMST\n\n# Median values of the \
posterior samples for all the parameters,\n# except psi and the coalescence \
phase that are set to 0\n\nz = onp.array([0.0980])\ntGPS = \
onp.array([61094.012])\n\ntest = {'Mc':onp.array([1.1859])*(1.+z),\n          \
  'dL':onp.array([1]), #Planck18.luminosity_distance(z).value/1000,\n         \
   'theta':onp.array([0.4080839999999999]),\n            \
'phi':onp.array([3.4461599999999994]),\n            \
'iota':onp.array([2.545065595974997]),\n            'psi':onp.array([2.3]),\n \
           'tcoal':onp.array([0.]), # GMST is LMST computed at long = 0\
\[Degree]\n            'eta':onp.array([0.24786618323504223]),\n            \
'Phicoal':onp.array([0]),\n            \
'chi1z':onp.array([0.005136138323169717]),\n            \
'chi2z':onp.array([0.003235146993487445])\n        }\n\nprint('Parameters for \
test are:')\ntest\n\>\""}], "]"}]], "Code",
 CellChangeTimes->{{3.948372352200296*^9, 3.948372358796226*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"5bf4fa3a-4c5e-4d29-a187-c881c09c45af"],

Cell[BoxData["\<\"Parameters for test are:\"\>"], "Print",
 CellChangeTimes->{3.9483723853976383`*^9},
 CellLabel->
  "During evaluation of \
In[8]:=",ExpressionUUID->"b9f89f07-45d6-4399-8247-a4e8081b765c"],

