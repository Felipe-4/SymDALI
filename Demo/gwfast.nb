    RowBox[{"x", "!=", "0"}], " ", "&&", 
    RowBox[{"y", "!=", "0"}]}]}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
