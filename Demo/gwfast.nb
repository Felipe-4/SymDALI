Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", 
   " ", "\"\<\nimport jax\nimport os\nimport sys\n\nimport copy\nimport numpy \
as onp\nfrom astropy.cosmology import Planck18\n\nPACKAGE_PARENT = '..'\n\
SCRIPT_DIR = os.path.dirname(os.path.realpath(os.path.join(os.getcwd())))\n\
sys.path.append(SCRIPT_DIR)\nimport gwfast.gwfastGlobals as glob\n\>\""}], 
  "]"}]], "Code",
