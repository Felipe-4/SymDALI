Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", 
   "\"\<\n# We use the O2 psds\nLVdetectors['L1']['psd_path'] = \
os.path.join(glob.detPath, 'LVC_O1O2O3', \
'2017-08-06_DCH_C02_L1_O2_Sensitivity_strain_asd.txt')\n\
LVdetectors['H1']['psd_path'] = os.path.join(glob.detPath, 'LVC_O1O2O3', \
'2017-06-10_DCH_C02_H1_O2_Sensitivity_strain_asd.txt')\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.9483720829107313`*^9, 3.948372097972413*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"29f77fc6-7efd-4e81-b9ff-0351d5ce5fda"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<\nfrom gwfast.waveforms import IMRPhenomD\nfrom gwfast.signal import \
GWSignal\nfrom gwfast.network import DetNet\nfrom fisherTools import CovMatr, \
compute_localization_region, check_covariance, fixParams\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.948372108134741*^9, 3.9483721259903393`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"83bfd391-8425-4fbf-89dc-614eb4ea58ff"],

Cell[BoxData["\<\"TEOBResumS is not installed, only the GWFAST waveform \
models are available, namely: TaylorF2, IMRPhenomD, IMRPhenomD_NRTidalv2, \
IMRPhenomHM and IMRPhenomNSBH\"\>"], "Print",
 CellChangeTimes->{3.94837212698553*^9, 3.948372330908833*^9},
 CellLabel->
  "During evaluation of \
In[6]:=",ExpressionUUID->"51c525b9-2f75-4740-ad79-7d94c857ac62"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<\nmyLVSignals = {}\n\nfor d in ['L1', 'H1']:\n\n    myLVSignals[d] = \
GWSignal(IMRPhenomD(),\n                psd_path=LVdetectors[d]['psd_path'],\n\
                detector_shape = LVdetectors[d]['shape'],\n                \
det_lat= LVdetectors[d]['lat'],\n                \
det_long=LVdetectors[d]['long'],\n                \
det_xax=LVdetectors[d]['xax'],\n                verbose=True,\n               \
 useEarthMotion = False,\n                fmin= 20.,\n                fmax = \
1024.,\n                IntTablePath=None,\n                \
jitCompileDerivs=True)\n\nmyLVNet = DetNet(myLVSignals)\n\>\""}], 
  "]"}]], "Code",
 CellChangeTimes->{{3.948372147225052*^9, 3.948372155012616*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"ea4e0650-3ead-4ba8-b176-c28b9f7a7f92"],

