    RowBox[{"y", "==", "0"}]}]}], " ", ":=", " ", "0"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RelativeDiff", "[", 
    RowBox[{"0", ",", " ", "y_"}], "]"}], "/;", " ", 
   RowBox[{"y", "!=", "0"}]}], " ", ":=", " ", "1"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
