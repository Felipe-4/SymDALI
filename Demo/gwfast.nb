Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", 
   " ", "\"\<\nimport numpy as np\nimport emcee\nchain = np.array(<*chainR*>)\
\nemcee.autocorr.integrated_time(chain)\n\n\>\""}], "]"}]], "Code",ExpressionU\
UID->"12b85a00-0a45-47e9-aa3b-1cc15499afb9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", 
   ",", "\"\<\nimport numpy as np\ndef chain_reduce(chain, burn, thin):\n\ta \
= chain[burn:, :, :]\n\ta = a[::thin, :, :]\n\tnw, ns, d = a.shape\n\ta = \
a.reshape(nw*ns, d)\n\treturn a\n\>\""}], "]"}]], "Code",
 CellChangeTimes->{{3.9518999153674517`*^9, 3.9519000169057693`*^9}, {
  3.952093230636516*^9, 3.952093234132552*^9}},
