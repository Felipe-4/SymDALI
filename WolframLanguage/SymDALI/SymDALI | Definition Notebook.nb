Cell["We reshape it into the usual form of a matrix and invert it:", "Text",
 CellChangeTimes->{{4.001679233792486*^9, 4.0016792466621017`*^9}},
 CellID->1224927099,ExpressionUUID->"dc2b101b-151b-45d0-a76f-2798e0057932"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FM2", "=", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{"FM", ",", 
     RowBox[{"{", 
      RowBox[{"11", ",", "11"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"Cov", ",", "epsilon"}], "}"}], "=", 
   RowBox[{"CholeskyInverse", "[", "FM2", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.001679247863858*^9, 4.0016792558143797`*^9}},
 CellLabel->"In[71]:=",
 CellID->1821443391,ExpressionUUID->"e72135dd-f203-4fbb-9de3-aaf1ae4fd36c"],

Cell["\<\
epsilon gives the difference between the product of the Fisher and Covariance \
with respect to the identity matrix:\
\>", "Text",
 CellChangeTimes->{{4.001679270996867*^9, 4.0016793337025833`*^9}},
 CellID->858694730,ExpressionUUID->"1eed5db2-455c-4e22-b9f6-97140001e664"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"epsilon", " ", "==", " ", 
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"Join", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"Cov", ".", "FM2"}], "-", " ", 
       RowBox[{"IdentityMatrix", "[", "11", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"FM2", ".", "Cov"}], "-", 
       RowBox[{"IdentityMatrix", "[", "11", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}], "//", "Abs"}], "]"}]}]], "Input",
 CellChangeTimes->{{4.001679262132215*^9, 4.001679264090938*^9}, {
  4.001679435520628*^9, 4.0016795267116756`*^9}},
 CellLabel->"In[80]:=",
 CellID->1795377338,ExpressionUUID->"4e056599-6d4c-4ce8-adb0-a8172f6fb2ab"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  4.0016792646657057`*^9, 4.0016793355041113`*^9, {4.00167946684238*^9, 
   4.0016795269624367`*^9}},
 CellLabel->"Out[80]=",
 CellID->1225906665,ExpressionUUID->"5f5711ad-5ebd-416b-af37-28abebd67814"]
}, Open  ]],

Cell["\<\
The relation between matrix dimensions and waveform variables can be obtained \
with EmptyAssociation:\
\>", "Text",
 CellChangeTimes->{{4.001679364024716*^9, 4.001679385787899*^9}},
 CellID->1352467119,ExpressionUUID->"0f2fda88-54e1-4b09-9911-154a95e791b2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"EmptyAssociation", "[", "\"\<Aligned\>\"", "]"}]], "Input",
 CellChangeTimes->{{4.001679393027514*^9, 4.0016793930330153`*^9}},
 CellLabel->"In[76]:=",
 CellID->1868421496,ExpressionUUID->"fb18afe3-68ef-45ab-88df-9d6a9932dd74"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"dec\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"phi\"\>", "\[Rule]", "2"}], ",", 
   RowBox[{"\<\"psi\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"Mc\"\>", "\[Rule]", "4"}], ",", 
   RowBox[{"\<\"q\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"s1z\"\>", "\[Rule]", "6"}], ",", 
   RowBox[{"\<\"s2z\"\>", "\[Rule]", "7"}], ",", 
   RowBox[{"\<\"iota\"\>", "\[Rule]", "8"}], ",", 
   RowBox[{"\<\"invdL\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"tc\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"phiRef\"\>", "\[Rule]", "11"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.001679393739647*^9},
 CellLabel->"Out[76]=",
 CellID->1033381986,ExpressionUUID->"7ddfa426-f9be-4e07-b50b-db3708fbb2da"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

