Cell[CellGroupData[{

Cell["Basic Examples", "Subsection",
 TaggingRules->{},
 CellID->816121734,ExpressionUUID->"9b9a5aed-9f06-4f95-9bd9-88b71547305e"],

Cell["\<\
We can calculate the plus and cross polarizations of the IMRPhenomHM waveform:\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.0016782188103733`*^9, 4.001678234349505*^9}, {
   4.0016782863688393`*^9, 4.0016783064902287`*^9}, 4.0016783596873503`*^9, {
   4.001679585538328*^9, 4.0016795858150387`*^9}},
 CellTags->"DefaultContent",
 CellID->489008670,ExpressionUUID->"751b682f-2550-4ef9-887b-854981e1f696"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"5", ",", "1024", ",", "0.25"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Mc", " ", "=", " ", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"q", "=", "0.9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s1z", "=", " ", "0.1"}], ";", " ", 
  RowBox[{"s2z", "=", 
   RowBox[{"-", "0.3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iota", " ", "=", " ", "\[Pi]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tc", " ", "=", " ", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phiRef", " ", "=", " ", 
   RowBox[{"\[Pi]", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dL", " ", "=", " ", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"hp", ",", "hc"}], "}"}], " ", "=", " ", 
   RowBox[{"hphcIMRPhenomHM", "[", 
    RowBox[{
    "f", ",", " ", "Mc", ",", " ", "q", ",", " ", "s1z", ",", " ", "s2z", ",",
      " ", "iota", ",", " ", "tc", ",", " ", "phiRef", ",", " ", 
     RowBox[{"1", "/", "dL"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.001678350820613*^9, 4.001678416041926*^9}, {
  4.0016784612007504`*^9, 4.001678461426466*^9}, {4.001678722725245*^9, 
  4.0016787322024393`*^9}, {4.001678915564575*^9, 4.001678917094068*^9}},
 CellLabel->"In[53]:=",
 CellID->1591070402,ExpressionUUID->"83ce9611-ba39-4ae3-a807-a6ecca26d8ab"],

Cell["\<\
So we can check the real and imaginary part of the plus polarization\
\>", "Text",
 CellChangeTimes->{{4.001678469566189*^9, 4.001678504181136*^9}, 
   4.00167894029974*^9},
 CellID->1589344733,ExpressionUUID->"c89b681e-02f7-40ac-93a6-f323e39ecdbc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "@", "hp"}], ",", " ", 
     RowBox[{"Im", "@", "hp"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"5", ",", "100"}], "}"}], ",", " ", "All"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"DataRange", "->", 
    RowBox[{"{", 
     RowBox[{"5", ",", " ", "1024"}], "}"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"ScalingFunctions", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Log10\>\"", ",", " ", "None"}], "}"}]}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{4.001678506859371*^9, 4.001678511225349*^9}, {
   4.00167854950887*^9, 4.001678613174865*^9}, 4.001678659017683*^9, {
