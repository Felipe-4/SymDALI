Cell["\<\
This paclet provides the Wolfram Language components of the SymDALI \
framework, a hybrid Python\[Dash]Wolfram Language framework for \
gravitational-wave parameter estimation using Fisher and DALI (Derivative \
Approximation of LIkelihoods) approximations.\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.0016771485667887`*^9, 4.00167720984993*^9}, {
  4.0016774273622017`*^9, 4.0016775445546637`*^9}, {4.001678102827075*^9, 
  4.001678117979329*^9}, {4.001678163975957*^9, 4.001678164325989*^9}},
 CellTags->"DefaultContent",
 CellID->312061637,ExpressionUUID->"b35616f3-2406-496e-8ddc-3eb6dc91567d"]
}, Open  ]],

