Cell["Scope", "Subsection",
 TaggingRules->{},
 CellID->189825519,ExpressionUUID->"fdfe91ef-bde9-4923-9ba0-b26d15956e1b"],

Cell["\<\
You can calculate the Fisher matrix for a network of Einstein telescope \
detectors with the IMRPhenomHM waveform\
\>", "Text",
 TaggingRules->{},
 CellChangeTimes->{{4.001678956369932*^9, 4.001679018761622*^9}, {
  4.001679134523814*^9, 4.001679155785759*^9}, {4.001679571029174*^9, 
  4.001679578845379*^9}},
 CellTags->"DefaultContent",
 CellID->386206736,ExpressionUUID->"65796947-1dae-4cba-940a-477f5bf75584"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fp", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<dec\>\"", "->", 
       RowBox[{"-", "0.883787"}]}], ",", 
      RowBox[{"\"\<phi\>\"", "->", "6.18412"}], ",", 
      RowBox[{"\"\<psi\>\"", "->", "0.471846"}], ",", 
      RowBox[{"\"\<Mc\>\"", "->", "190.258"}], ",", 
      RowBox[{"\"\<q\>\"", "->", "0.935815"}], ",", 
      RowBox[{"\"\<s1z\>\"", "->", "0.107562"}], ",", 
      RowBox[{"\"\<s2z\>\"", "->", 
       RowBox[{"-", "0.0254365"}]}], ",", 
      RowBox[{"\"\<iota\>\"", "->", "2.60021"}], ",", 
      RowBox[{"\"\<invdL\>\"", "->", "0.0284797"}], ",", 
      RowBox[{"\"\<tc\>\"", "->", "61093.87906420612"}], ",", 
      RowBox[{"\"\<phiRef\>\"", "->", "5.93578"}]}], "|>"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ET1", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Position\>\"", "->", 
       RowBox[{"DetectorVertex", "[", "\"\<ET-S\>\"", "]"}]}], ",", 
      RowBox[{"\"\<DetectorTensor\>\"", "->", 
       RowBox[{"DetectorTensor", "[", "\"\<ET-S-L\>\"", "]"}]}], ",", 
      RowBox[{"\"\<ASD\>\"", "->", 
       RowBox[{"ASD", "[", "\"\<ET-15-lfhf\>\"", "]"}]}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ET2", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Position\>\"", "->", 
       RowBox[{"DetectorVertex", "[", "\"\<ET-MR\>\"", "]"}]}], ",", 
      RowBox[{"\"\<DetectorTensor\>\"", "->", 
       RowBox[{"DetectorTensor", "[", "\"\<ET-MR-L-45\>\"", "]"}]}], ",", 
      RowBox[{"\"\<ASD\>\"", "->", 
       RowBox[{"ASD", "[", "\"\<ET-15-lfhf\>\"", "]"}]}]}], "|>"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FM", " ", "=", " ", 
   RowBox[{"DALITensors", "[", 
    RowBox[{"\"\<IMRPhenomHM\>\"", ",", "fp", ",", 
     RowBox[{"{", 
      RowBox[{"ET1", ",", "ET2"}], "}"}], ",", "1"}], "]"}]}], 
  ";"}]}], "Input",
 TaggingRules->{},
 CellChangeTimes->{{4.001679107972056*^9, 4.001679130325851*^9}, {
  4.001679177099247*^9, 4.001679199437769*^9}},
 CellTags->"DefaultContent",
 CellLabel->"In[67]:=",
 CellID->950561860,ExpressionUUID->"36724770-eac2-4198-8088-82c04b696516"],

