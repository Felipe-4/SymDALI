                   RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"4", " ", "\[Eta]"}]}], "]"}]}], ")"}], "^", 
                 "2"}], " ", "\[Chi]2"}]}]}], ";", "\n", "\t\t\t\t", 
             RowBox[{"\[Chi]PN", " ", "=", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"76", " ", 
                   RowBox[{"\[Eta]", "/", "113"}]}]}], ")"}], " ", 
                FractionBox[
                 RowBox[{"\[Chi]1", "+", "\[Chi]2"}], "2"]}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"1", "-", 
                  RowBox[{"4", " ", "\[Eta]"}]}], "]"}], " ", 
                FractionBox[
                 RowBox[{"\[Chi]1", "-", "\[Chi]2"}], "2"]}]}]}], ";", "\n", 
             "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"\[Omega]rd", "[", 
               RowBox[{"\[Eta]_", ",", " ", "S_"}], "]"}], " ", ":=", " ", 
              "RD"}], ";", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"\[Omega]damp", "[", 
               RowBox[{"\[Eta]_", ",", "S_"}], "]"}], " ", ":=", " ", 
              "DAMP"}], ";", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"SF", "[", 
               RowBox[{"\[Eta]_", ",", " ", "S_"}], "]"}], " ", ":=", " ", 
              "sf"}], ";", "\n", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"\[Gamma]1", "[", 
               RowBox[{"\[Eta]_", ",", " ", "\[Chi]PN_"}], "]"}], " ", ":=", 
              " ", "\[CapitalGamma]1"}], ";", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"\[Gamma]2", "[", 
               RowBox[{"\[Eta]_", ",", " ", "\[Chi]PN_"}], "]"}], " ", ":=", 
              " ", "\[CapitalGamma]2"}], ";", "\n", "\t\t\t\t", 
             RowBox[{
              RowBox[{"\[Gamma]3", "[", 
               RowBox[{"\[Eta]_", ",", " ", "\[Chi]PN_"}], "]"}], " ", ":=", 
              " ", "\[CapitalGamma]3"}], ";", "\n", "\t\t\t\t", "\n", 
             "\t\t\t\t", 
             RowBox[{"(*", 
              RowBox[{"Absorbing", " ", 
               SqrtBox["\[Eta]"], " ", "in", " ", 
               RowBox[{"\[Gamma]1", ":"}]}], "*)"}], "\n", "\t\t\t\t", 
             RowBox[{
              SuperscriptBox["\[Omega]", 
               RowBox[{
                RowBox[{"-", "7"}], "/", "6"}]], " ", 
              RowBox[{"\[Gamma]1", "[", 
               RowBox[{"\[Eta]", ",", " ", "\[Chi]PN"}], "]"}], " ", 
              FractionBox[
               RowBox[{
                RowBox[{"\[Gamma]3", "[", 
                 RowBox[{"\[Eta]", ",", " ", "\[Chi]PN"}], "]"}], " ", 
                RowBox[{"SF", "[", 
                 RowBox[{"\[Eta]", ",", "S"}], "]"}], " ", 
                RowBox[{"\[Omega]damp", "[", 
                 RowBox[{"\[Eta]", ",", "S"}], "]"}]}], 
               RowBox[{
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"\[Omega]", " ", "-", " ", 
                   RowBox[{
                    RowBox[{"SF", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}], " ", 
                    RowBox[{"\[Omega]rd", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}]}]}], ")"}], "2"], " ",
                 "+", " ", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"\[Gamma]3", "[", 
                    RowBox[{"\[Eta]", ",", " ", "\[Chi]PN"}], "]"}], " ", 
                   RowBox[{"SF", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}], " ", 
                   RowBox[{"\[Omega]damp", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}]}], ")"}], "2"]}]], 
              " ", 
              RowBox[{"Exp", "[", 
               RowBox[{"-", 
                FractionBox[
                 RowBox[{
                  RowBox[{"\[Gamma]2", "[", 
                   RowBox[{"\[Eta]", ",", "\[Chi]PN"}], "]"}], " ", 
                  RowBox[{"(", 
                   RowBox[{"\[Omega]", " ", "-", " ", 
                    RowBox[{
                    RowBox[{"SF", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}], " ", 
                    RowBox[{"\[Omega]rd", "[", 
                    RowBox[{"\[Eta]", ",", "S"}], "]"}]}]}], ")"}]}], 
                 RowBox[{
                  RowBox[{"\[Gamma]3", "[", 
                   RowBox[{"\[Eta]", ",", " ", "\[Chi]PN"}], "]"}], " ", 
                  RowBox[{"SF", "[", 
                   RowBox[{"\[Eta]", ",", "S"}], "]"}], " ", 
                  RowBox[{"\[Omega]damp", "[", 
                   RowBox[{"\[Eta]", ",", "S"}], "]"}]}]]}], "]"}]}]}]}], 
           "\n", "\t\t", "]"}], ",", "\n", "\t\t", 
          RowBox[{"\"\<KeepDefs\>\"", " ", "->", " ", 
           RowBox[{"{", "\n", "\t\t\t", 
            RowBox[{
             RowBox[{"S", " ", "->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"1", "/", "4"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", " ", "+", " ", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"4", " ", "\[Eta]"}]}], "]"}]}], ")"}], "^", 
                 "2"}], " ", "\[Chi]1"}], " ", "+", "  ", 
               RowBox[{
                RowBox[{"1", "/", "4"}], " ", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "-", 
                    RowBox[{"4", " ", "\[Eta]"}]}], "]"}]}], ")"}], "^", 
                 "2"}], " ", "\[Chi]2"}]}]}], ",", "\n", "\t\t\t", 
             RowBox[{"\[Chi]PN", " ", "->", " ", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"76", " ", 
                   RowBox[{"\[Eta]", "/", "113"}]}]}], ")"}], " ", 
                FractionBox[
                 RowBox[{"\[Chi]1", "+", "\[Chi]2"}], "2"]}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Sqrt", "[", 
                 RowBox[{"1", "-", 
                  RowBox[{"4", " ", "\[Eta]"}]}], "]"}], " ", 
                FractionBox[
                 RowBox[{"\[Chi]1", "-", "\[Chi]2"}], "2"]}]}]}]}], "\n", 
            "\t\t", "}"}]}]}], "\n", "\t", "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"RD", " ", "->", " ", "\[CapitalOmega]RD"}], ",", " ", 
         RowBox[{"DAMP", "->", " ", "\[CapitalOmega]DAMP"}], ",", " ", 
         RowBox[{"sf", " ", "->", " ", "SpecialFreq"}], ",", " ", "\n", 
         RowBox[{"\[CapitalGamma]1", "->", " ", "gamma1"}], ",", " ", 
         RowBox[{"\[CapitalGamma]2", "->", " ", "gamma2"}], ",", " ", 
         RowBox[{"\[CapitalGamma]3", "->", " ", "gamma3"}]}], " ", 
        "}"}]}]}]}], "\n", "]"}]}], ";"}]], "Code",
