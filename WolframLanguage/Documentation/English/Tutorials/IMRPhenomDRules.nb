Cell[BoxData[{
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{"FDAMP", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"0.014055787148647485`", " ", 
    RowBox[{"(", 
     RowBox[{"1", " ", "-", " ", 
      RowBox[{"E", "^", 
       RowBox[{"(", 
        RowBox[{"8.150574465175337`", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1.0479012727408963`"}], "+", "x"}], ")"}]}], 
        ")"}]}]}], ")"}]}]}], "]"}], "\n", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{"FRD", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{"0.059184339277624086`", " ", "+", 
    RowBox[{"E", "^", 
     RowBox[{"(", 
      RowBox[{"4.494993811335756`", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1.625570103110631`"}], "+", "x"}], ")"}]}], ")"}]}], 
    "+", 
    RowBox[{"0.014137205950116518`", " ", "x"}]}]}], "]"}], "\n", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"aeff", "[", 
     RowBox[{"\[Eta]_", ",", " ", "S_"}], "]"}], "=", " ", 
    RowBox[{"S", " ", "+", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Sqrt", "[", "3.", "]"}], " ", "\[Eta]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "0.085`"}], " ", "S"}], "+", 
        RowBox[{"0.102`", " ", 
         RowBox[{"S", "^", "2"}]}], "-", 
        RowBox[{"1.355`", " ", 
         RowBox[{"S", "^", "3"}]}], "-", 
        RowBox[{"0.868`", " ", 
         RowBox[{"S", "^", "4"}]}]}], ")"}], " ", "\[Eta]"}], "-", 
     RowBox[{"4.399`", " ", 
      RowBox[{"\[Eta]", "^", "2"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "5.837`"}], " ", "S"}], "-", 
        RowBox[{"2.097`", " ", 
