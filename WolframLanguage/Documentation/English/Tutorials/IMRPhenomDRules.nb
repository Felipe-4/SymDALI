Cell[CellGroupData[{

Cell["Compiling and exporting", "Section",
 CellChangeTimes->{{3.934884879721966*^9, 3.934884886802123*^9}},
 CellID->1088182919,ExpressionUUID->"6acdadf5-4067-4ab5-8338-fb89339d5eb5"],

Cell[TextData[{
 "Now we just have to compile and export our rules to the default directory \
\"SymDALI/DerivativeRules/IMRPhenomD\" this directory should have 2 folders \
\"NRules\" and \"SymRules\" and an optional \"Defs.wdx\" file for additional \
definitions. IMRPhenomD additional definitions are done in: ",
 ButtonBox["IMRPhenomD Defs",
  BaseStyle->"Link",
  ButtonData->"paclet:FelipeBarbosa/SymDALI/tutorial/IMRPhenomDDefs"],
 "."
}], "Text",
 CellChangeTimes->{{3.9348856495210323`*^9, 3.934885667822556*^9}, {
  3.934961155764988*^9, 3.934961213094981*^9}},
 CellID->1299560146,ExpressionUUID->"50f62d3d-5776-4978-9cc9-04871fa8603c"],

Cell["", "Text",
 CellChangeTimes->{{3.9348856495210323`*^9, 3.934885667822556*^9}, {
  3.934961156193728*^9, 3.9349611561956472`*^9}},
 CellID->1663676627,ExpressionUUID->"42348106-3b66-4326-9b26-ffbd7a75d2dd"],

Cell[CellGroupData[{

Cell[" For SymRules, saving is straightforward:", "Text",
 CellChangeTimes->{{3.9348856495210323`*^9, 3.934885667822556*^9}, {
  3.934961217943869*^9, 3.934961229432836*^9}},
 CellID->1659320060,ExpressionUUID->"b12a4a8e-e4c2-4b63-a590-05b564498d4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", "\t", 
     RowBox[{"directory", " ", "=", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{
        RowBox[{"ParentDirectory", "[", 
         RowBox[{
          RowBox[{"NotebookDirectory", "[", "]"}], ",", " ", "3"}], "]"}], 
        ",", " ", "\"\<DerivativeRules/IMRPhenomD/SymRules\>\""}], "]"}]}], 
     "}"}], ",", "\[IndentingNewLine]", "\t", 
    RowBox[{"SaveSymRules", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"SymRules", ",", " ", "\"\<SymRules\>\""}], "}"}], ",", " ", 
      "directory"}], "]"}]}], "\[IndentingNewLine]", "]"}], ";"}]], "Code",
 CellChangeTimes->{{3.934885701995513*^9, 3.934885703817618*^9}, {
   3.934885740876321*^9, 3.9348857714750767`*^9}, {3.934885801503942*^9, 
   3.934885822014958*^9}, {3.9348858998416986`*^9, 3.9348859589863787`*^9}, {
   3.9348860218381147`*^9, 3.9348860870609093`*^9}, {3.934886118864456*^9, 
   3.934886142383027*^9}, {3.934886217617392*^9, 3.9348862270663233`*^9}, {
   3.9348863475707397`*^9, 3.9348863509398813`*^9}, 3.934886484760242*^9, {
   3.934886603870886*^9, 3.9348866065467863`*^9}, {3.934887010426025*^9, 
   3.934887012118855*^9}, {3.934892388675859*^9, 3.934892392347225*^9}, {
   3.9348927155877943`*^9, 3.934892715977497*^9}, 3.934959273603839*^9},
 CellLabel->"In[51]:=",
 CellID->394018130,ExpressionUUID->"f6bf98dd-76a6-41dd-aad1-e13047f0946e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Before exporting the NRules, we need to extract the LibraryFunction of their \
compiled versions. First we need all function variables\
\>", "Text",
 CellChangeTimes->{{3.9348871529323883`*^9, 3.934887180079144*^9}, {
  3.934887481732869*^9, 3.934887533599553*^9}, {3.934887617908409*^9, 
  3.934887621749954*^9}, {3.934887716569351*^9, 3.934887723016024*^9}, {
  3.9348886633884172`*^9, 3.934888668330155*^9}},
 CellID->1326830313,ExpressionUUID->"2edbe7e3-4b0e-4437-aea6-dcb866c1f682"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"vars", " ", "=", "  ", 
    RowBox[{"<|", "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Do", "[", "\n", "\t", 
  RowBox[{
   RowBox[{
    RowBox[{"vars", "[", "i", "]"}], " ", "=", " ", 
    RowBox[{"List", "@@", 
     RowBox[{
      RowBox[{"NRules", "[", "i", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", " ", "1", ",", "All", ",", " ", "1"}], "]"}], 
      "]"}]}]}], ",", " ", "\n", "\t", 
   RowBox[{"{", 
    RowBox[{"i", ",", " ", 
     RowBox[{"Keys", "@", "NRules"}]}], "}"}]}], "\n", "]"}]}], "Code",
 CellChangeTimes->{{3.934887183814413*^9, 3.934887242147956*^9}, {
   3.93488756224502*^9, 3.934887577895335*^9}, {3.934888521081724*^9, 
   3.9348887305210047`*^9}, 3.934892928305197*^9, {3.934959918790605*^9, 
   3.934959920433002*^9}, {3.9355548059890842`*^9, 3.935554806762217*^9}},
 CellLabel->"In[52]:=",
 CellID->1914986029,ExpressionUUID->"fc7d38da-ef88-453a-b4f7-137403ac17ab"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Now, we need a way to pass CLibraryFunction that does not distinguish if the \
function has or not a HoldForm around it\
\>", "Text",
 CellChangeTimes->{{3.934888779803063*^9, 3.93488882130024*^9}},
 CellID->1088762323,ExpressionUUID->"e9c4a03e-1c44-4954-adfc-b403a1ddb65e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"PassFunction", "[", 
   RowBox[{"vars_", ",", " ", "expr_"}], "]"}], " ", ":=", " ", 
  RowBox[{"CLibraryFunction", "[", 
   RowBox[{"vars", ",", " ", "expr"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PassFunction", "[", 
    RowBox[{"vars_", ",", " ", "expr_"}], "]"}], "/;", " ", 
   RowBox[{
    RowBox[{"Head", "@", "expr"}], "===", "HoldForm"}]}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"Unevaluated", "@", 
    RowBox[{"CLibraryFunction", "[", 
     RowBox[{"vars", ",", " ", "expr"}], "]"}]}], "/.", 
   RowBox[{
    RowBox[{"HoldForm", "[", "x_", "]"}], " ", "->", " ", "x"}]}]}]}], "Code",\

 CellChangeTimes->{{3.934888823052237*^9, 3.934888906237111*^9}, {
  3.93488895040095*^9, 3.934888960608638*^9}, {3.934889121267239*^9, 
  3.934889186639524*^9}},
 CellLabel->"In[54]:=",
 CellID->1827292164,ExpressionUUID->"36eff92e-ddeb-42a0-9e07-36b2b9a11157"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now we calculate the compiled functions:", "Text",
 CellChangeTimes->{{3.9348905117132683`*^9, 3.934890513720634*^9}, 
   3.936757760633243*^9},
 CellID->1257074012,ExpressionUUID->"7abf177f-9140-4069-99f1-b1d8e63b8485"],

Cell[BoxData[
 RowBox[{
  RowBox[{"newNRules", " ", "=", " ", 
   RowBox[{"Association", "@", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"keys", " ", "=", " ", 
        RowBox[{"Keys", "@", "NRules"}]}], "}"}], ",", "\n", "\t", 
      RowBox[{"Table", "[", "\n", "\t\t", 
       RowBox[{
        RowBox[{"i", " ", "->", " ", 
         RowBox[{"MapAt", "[", "\n", "\t\t\t", 
          RowBox[{
           RowBox[{
            RowBox[{"PassFunction", "[", 
             RowBox[{
              RowBox[{"vars", "[", "i", "]"}], ",", " ", "#"}], "]"}], "&"}], 
           ",", "\n", "\t\t\t", 
           RowBox[{"NRules", "[", "i", "]"}], ",", " ", "\n", "\t\t\t", 
           RowBox[{"{", 
            RowBox[{"All", ",", " ", "2"}], "}"}]}], "\n", "\t\t", "]"}]}], 
        ",", "\n", "\n", "\t\t", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "keys"}], "}"}]}], "\n", "\t", "]"}]}], "\n", 
     "]"}]}]}], ";"}]], "Code",
 CellChangeTimes->{{3.934888738377204*^9, 3.934888742248023*^9}, {
   3.934888983021904*^9, 3.9348891036888437`*^9}, {3.934889235069003*^9, 
   3.934889314076305*^9}, {3.9348893502397747`*^9, 3.9348893512035303`*^9}, 
   3.934889431917697*^9, {3.934889540263526*^9, 3.934889676290853*^9}, {
   3.934889724005084*^9, 3.9348898107578297`*^9}, {3.934889977465364*^9, 
   3.9348899967888737`*^9}, {3.934890636895885*^9, 3.934890637719816*^9}, 
   3.934890702924115*^9, 3.935554825552928*^9, 3.935651108147729*^9},
 CellLabel->"In[56]:=",
 CellID->779699645,ExpressionUUID->"9056996a-595a-4ecd-a0ab-33ebe6570639"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Keys", "@", "newNRules"}]], "Input",
 CellChangeTimes->{{3.936856931212488*^9, 3.936856935847781*^9}},
 CellLabel->"In[57]:=",
 CellID->1047873215,ExpressionUUID->"1c878dd9-8c55-4d02-9ca2-a07413be89ae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"\[Omega]RD\"\>", ",", "\<\"\[Omega]Peak\"\>", 
