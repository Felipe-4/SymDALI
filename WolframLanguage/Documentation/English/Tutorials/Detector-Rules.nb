Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"S1", "[", 
    RowBox[{"\[Alpha]", ",", "sin\[Delta]", ",", "cos\[Iota]"}], "]"}], "===", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       RowBox[{
        SubscriptBox["F", "+"], "[", 
        RowBox[{"\[Alpha]", ",", "\[Delta]", ",", "GMST"}], "]"}], " ", 
