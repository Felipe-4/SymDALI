Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"newSymRules", " ", "=", " ", 
    RowBox[{"<|", "|>"}]}], ";", " ", 
   RowBox[{"newNRules", " ", "=", " ", 
    RowBox[{"<|", "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"newSymRules", "[", "\"\<detectors\>\"", "]"}], ",", " ", 
     RowBox[{"newNRules", "[", "\"\<detectors\>\"", "]"}]}], "}"}], " ", "=", 
   " ", 
   RowBox[{"Module", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"addVars", ",", "headsNR", ",", " ", "headsSR"}], "}"}], ",", 
     "\n", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{
      "Make", " ", "a", " ", "function", " ", "to", " ", "change", " ", "the",
        " ", 
       RowBox[{"heads", ":"}]}], "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"addVars", "[", "x_", "]"}], "/;", " ", 
        RowBox[{"(", 
         RowBox[{"AtomQ", "[", 
          RowBox[{"x", "[", 
           RowBox[{"[", "0", "]"}], "]"}], "]"}], ")"}]}], " ", ":=", " ", 
       RowBox[{"Join", "[", "\n", "\t\t", 
        RowBox[{"x", ",", " ", "\n", "\t\t", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", "0", "]"}], "]"}], "[", 
          RowBox[{
          "gmst_", ",", " ", "detectorPosition_", ",", " ", "detectorTensor_",
            ",", " ", "f_"}], "]"}]}], "\n", "\t", "]"}]}], ";", "\n", "\t", 
      "\n", "\t", 
      RowBox[{
       RowBox[{"addVars", "[", "x_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", "\n", "\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"newHead", " ", "=", " ", 
           RowBox[{"x", "[", 
            RowBox[{"[", "0", "]"}], "]"}]}], "}"}], ",", " ", "\n", "\t\t", 
         RowBox[{
          RowBox[{
           RowBox[{"newHead", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"newHead", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], 
          ";", "\n", "\t\t", 
          RowBox[{"Join", "[", "\n", "\t\t\t", 
           RowBox[{
            RowBox[{"newHead", "@@", "x"}], ",", " ", "\n", "\t\t\t", 
            RowBox[{"newHead", "[", 
             RowBox[{
             "gmst_", ",", " ", "detectorPosition_", ",", " ", 
              "detectorTensor_", ",", " ", "f_"}], "]"}]}], "\n", "\t\t", 
           "]"}]}]}], "\n", "\t", "]"}]}], ";", "\n", "\t", "\n", "\t", 
      RowBox[{"headsNR", " ", "=", " ", 
       RowBox[{"addVars", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"NRules", "[", "\"\<detectors\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ")"}]}]}], ";", "\n",
       "\t", 
      RowBox[{"headsSR", " ", "=", " ", 
       RowBox[{"addVars", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SymRules", "[", "\"\<detectors\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ")"}]}]}], ";", "\n",
       "\n", "\t", 
      RowBox[{"(*", 
       RowBox[{"Return", " ", "the", " ", "new", " ", "lists", " ", "of", " ", 
        RowBox[{"rules", ":"}]}], "*)"}], "\n", "\t", 
      RowBox[{"{", "\n", "\t\t", 
       RowBox[{
        RowBox[{"Thread", "@", 
         RowBox[{"Rule", "[", 
          RowBox[{"headsSR", ",", " ", 
           RowBox[{
            RowBox[{"SymRules", "[", "\"\<detectors\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
        "\t\t", 
        RowBox[{"Thread", "@", 
         RowBox[{"Rule", "[", 
          RowBox[{"headsNR", ",", " ", 
           RowBox[{
            RowBox[{"NRules", "[", "\"\<detectors\>\"", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "]"}]}]}], "\n", "\t",
        "}"}]}]}], "\n", "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.937372768731491*^9, 3.937372824102292*^9}, {
   3.937372861689286*^9, 3.9373729731544*^9}, {3.9373730301311083`*^9, 
