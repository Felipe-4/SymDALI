Cell["The gravitational wave strain is defined by:", "Text",
 CellChangeTimes->{{3.937289361839155*^9, 3.937289390503375*^9}},
 CellID->311329452,ExpressionUUID->"e5884b39-f028-40ee-a97c-ef4c1a475d4c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"HoldForm", "[", 
  RowBox[{"strain", " ", "===", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["F", "+"], "[", 
        RowBox[{"\[Alpha]", ",", " ", "\[Delta]", ",", " ", "GMST"}], "]"}], 
       " ", 
       SubscriptBox["h", "+"]}], " ", "+", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "x"], "[", 
        RowBox[{"\[Alpha]", ",", " ", "\[Delta]", ",", " ", "GMST"}], "]"}], 
       " ", 
       SubscriptBox["h", "x"]}]}], ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
      "\[CapitalDelta]t"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   SubscriptBox["h", "+"], " ", "===", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", "+", 
       SuperscriptBox[
        RowBox[{"Cos", "[", "\[Iota]", "]"}], "2"]}], ")"}], "2"], "h"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   SubscriptBox["h", "x"], " ", "===", " ", 
   RowBox[{
    RowBox[{"-", "I"}], " ", 
    RowBox[{"Cos", "[", "\[Iota]", "]"}], " ", "h"}]}], "]"}]}], "Code",
 CellChangeTimes->{{3.9372893939654217`*^9, 3.937289537135227*^9}, {
  3.937289706479623*^9, 3.937289728343787*^9}, {3.937290043109336*^9, 
