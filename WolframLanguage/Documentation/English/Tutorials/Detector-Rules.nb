Cell[CellGroupData[{

Cell["\<\
Apparently ```Tr```is not compilable, so I will just change to its explicit \
definition in this case:\
\>", "Text",
 CellChangeTimes->{{3.937380616584325*^9, 3.937380645449045*^9}, {
  3.937381289143108*^9, 3.93738130979825*^9}},
 CellID->1452816203,ExpressionUUID->"49417fcb-719e-43e1-b452-f4a9462497ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"change", " ", "Tr"}], " ", "->", " ", 
    RowBox[{"to", " ", "the", " ", "def", " ", "of", " ", 
     RowBox[{"Trace", ":"}]}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"newNRules", "[", "\"\<detectors\>\"", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"newNRules", "[", "\"\<detectors\>\"", "]"}], "//.", 
     RowBox[{
      RowBox[{"Tr", "[", "x_", "]"}], " ", ":>", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"x", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}]}]}]}], 
   ";"}]}]], "Code",
 CellChangeTimes->{{3.937380681431596*^9, 3.93738070890232*^9}, {
  3.9373807581007357`*^9, 3.9373808615475492`*^9}, {3.937381314918858*^9, 
