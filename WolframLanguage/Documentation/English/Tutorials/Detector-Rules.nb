Cell[CellGroupData[{

Cell["\<\
Where, \[CapitalDelta]t is the time interval for the GW to propagate from the \
detector to the Earth's center (assuming speed of light velocity), GMST is \
the Greenwich mean sideral time of detection, \[Alpha] is the right ascension \
and \[Delta] is the declination. The implementation of detectors consists in \
rewriting the strain as:\
\>", "Text",
 CellChangeTimes->{{3.937289730498035*^9, 3.937289804018717*^9}, {
  3.9372899508409023`*^9, 3.937290021374236*^9}, {3.937290148427459*^9, 
  3.937290153655601*^9}},
 CellID->148712181,ExpressionUUID->"cfafccfd-6c34-4469-9a63-b884fb6aeb26"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"HoldForm", "[", 
  RowBox[{"strain", " ", "===", " ", 
   RowBox[{
    RowBox[{"S1", "[", 
     RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]", ",", " ", "cos\[Iota]"}], 
     "]"}], " ", "h"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{"S1", "[", 
    RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]", ",", " ", "cos\[Iota]"}], 
    "]"}], " ", "===", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        SubscriptBox["F", "+"], "[", 
        RowBox[{"\[Alpha]", ",", " ", "\[Delta]", ",", " ", "GMST"}], "]"}], 
       " ", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["cos\[Iota]", "2"]}], ")"}], "2"]}], " ", "-", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["F", "x"], "[", 
        RowBox[{"\[Alpha]", ",", " ", "\[Delta]", ",", " ", "GMST"}], "]"}], "  ",
        "I", " ", "cos\[Iota]"}]}], " ", ")"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
      "\[CapitalDelta]t"}], "]"}]}]}], "]"}]}], "Code",
 CellChangeTimes->{{3.937290024889408*^9, 3.9372901379708357`*^9}},
 CellLabel->"In[6]:=",
 CellID->1805837211,ExpressionUUID->"147bd7bf-8048-4594-b45d-89b31108c0c5"],

Cell[BoxData[
 TagBox[
  RowBox[{"strain", "===", 
   RowBox[{
    RowBox[{"S1", "[", 
     RowBox[{"\[Alpha]", ",", "sin\[Delta]", ",", "cos\[Iota]"}], "]"}], " ", 
    "h"}]}],
  HoldForm]], "Output",
 CellChangeTimes->{{3.937290139192013*^9, 3.937290162375296*^9}, 
   3.937361395718224*^9, 3.9373616453470287`*^9, 3.937369743216292*^9, 
   3.937387591951211*^9, 3.937442518801538*^9, 3.9375447743346443`*^9, 
   3.939095200443162*^9, 3.9390953020852613`*^9, 3.9390954322037277`*^9, 
   3.9390956079720907`*^9, 3.939095846676153*^9, 3.9390962912684603`*^9, 
   3.939101705897794*^9, 3.939102287542055*^9, 3.939104388797262*^9, 
   3.939111612762907*^9},
