    "\t", 
    RowBox[{
     RowBox[{"\[Theta]", "=", " ", 
      RowBox[{
       RowBox[{"\[Pi]", "/", "2"}], " ", "-", " ", "\[Delta]"}]}], ";", "\n", 
     "\n", "    ", 
     RowBox[{"eplus", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
