  ExternalFunction[
   ExternalSessionObject["4d708300-647c-4c4a-b4e7-6573acd02d78"], 
   "def function(ra, dec, gps, psi, cosiota, f):\n\tFp = \
detector.antenna_response(ra = ra, dec = dec,  time = gps, psi =psi, mode = \
'plus')\n\tFc = detector.antenna_response(ra = ra, dec = dec,  time = gps, \
psi =psi, mode = 'cross')\n\tdeltaT = detector.time_delay_from_geocenter(ra = \
ra, dec=dec, time = gps )\n\tdeltaT = np.exp(-1j*2*np.pi*f*deltaT)\n\tresult \
= (Fp*0.5*(1+cosiota**2) - complex(0,1)*cosiota*Fc)*deltaT\n\n\treturn result\
\n"],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
