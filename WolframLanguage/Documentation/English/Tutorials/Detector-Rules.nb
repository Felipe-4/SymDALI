              RowBox[{"sin\[Delta]", "^", "2"}]}], "]"}]}]}], "}"}]}], ")"}], 
       "//", "FullSimplify"}]}], ";", "\n", "\n", "\n", "    ", 
     RowBox[{"R2", " ", "=", " ", 
      RowBox[{"RotationMatrix", "[", 
       RowBox[{
        RowBox[{"-", "\[Psi]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", "\n", 
     "    ", 
     RowBox[{"T", " ", "=", " ", 
      RowBox[{
       RowBox[{"R2", " ", ".", " ", "R1"}], "//", "Simplify"}]}], ";", "\n", 
     "    ", "\n", "\t", 
     RowBox[{"eplusGeoFrame", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"T", "\[Transpose]"}], " ", ".", " ", "eplus", " ", ".", " ", 
