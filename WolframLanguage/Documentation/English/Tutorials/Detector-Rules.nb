Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "pythonArg", ",", " ", "MMAArg", ",", " ", "pythonABS", ",", " ", 
