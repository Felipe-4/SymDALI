       SubscriptBox["e", "x"], "[", 
       RowBox[{"\[Alpha]", ",", "sin\[Delta]", ",", "GMST"}], "]"}]}]}], 
    ")"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
     "\[CapitalDelta]t"}], "]"}]}],
  HoldForm]], "Output",
 CellChangeTimes->{
  3.937290910342985*^9, 3.937290966614789*^9, 3.93736139776511*^9, 
   3.937361647920971*^9, {3.937369745344503*^9, 3.9373697586933002`*^9}, 
   3.937387594336211*^9, 3.937442520681183*^9, 3.937544776257925*^9, 
   3.93909520045354*^9, 3.939095302096592*^9, 3.939095432213369*^9, 
