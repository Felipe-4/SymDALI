Cell[CellGroupData[{

Cell[TextData[{
 "and finding the derivatives of S1[\[Alpha], sin\[Delta], cos\[Iota]] \
analogously to what was done in ",
 ButtonBox["IMRPhenomD Rules",
  BaseStyle->"Link",
  ButtonData->"paclet:SymDALI/tutorial/IMRPhenomDRules"],
 ". First we recognize that  ",
 Cell[BoxData[
  SubscriptBox["F", "+"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "ca0cbd7a-0bfb-469d-aa30-cb9faa29b1d9"],
 "  \[Congruent] ",
 Cell[BoxData[
  SubscriptBox["e", 
   RowBox[{"+", 
    RowBox[{",", "ij"}]}]]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "12171f9b-ba8f-43d4-90bf-1aca10e2bdbd"],
 " ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "b95ae99a-2dad-4fe6-aa8a-ed10e2a0974b"],
 " \[And] ",
 Cell[BoxData[
  SubscriptBox["F", "x"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "abb931f8-9fd8-4c40-af10-e814df2b749e"],
 " \[Congruent] ",
 Cell[BoxData[
  SubscriptBox["e", 
   RowBox[{"x", ",", "ij"}]]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "e5cc6930-13f0-41f9-b417-6df3142a532e"],
 " ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "46358b7c-65b0-4b2d-b9f3-dd966eff6eae"],
 ", where ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "6255d1f4-4481-4bd6-9395-5e89076a3ff8"],
 " is the usual detector tensor ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "16ce241d-764a-4421-a396-3fbf391af2cc"],
 " \[Congruent] 1/2 ( ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["nx", "i"], 
   SubscriptBox["nx", "j"]}]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "be94b862-93e1-42e4-812c-c36693ea778a"],
 " - ",
 Cell[BoxData[
  SubscriptBox["ny", "i"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "c50bca38-cd6e-4640-a766-a36300a3da7d"],
 " ",
 Cell[BoxData[
  SubscriptBox["ny", "j"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "311d8760-94a9-4fc9-b002-e317bf65b1ac"],
 "). Meaning that we can factor ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "9b26ca20-6f07-4996-abc0-88a2e666ef24"],
 " and keep a function  that returns a matrix:"
}], "Text",
 CellChangeTimes->{{3.937290315848255*^9, 3.9372904986358852`*^9}, {
  3.937290620286233*^9, 3.937290673466251*^9}, {3.937290712305685*^9, 
  3.937290763724084*^9}},
 CellID->278885095,ExpressionUUID->"f9e69028-7d28-4390-8052-6ff7d8c435a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["e", "+"], "[", 
       RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]", ",", " ", "GMST"}], "]"}],
       " ", 
      FractionBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["cos\[Iota]", "2"]}], ")"}], "2"]}], " ", "-", " ", 
     RowBox[{"I", " ", "cos\[Iota]", " ", 
      RowBox[{
       SubscriptBox["e", "x"], "[", 
       RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]", ",", " ", "GMST"}], 
       "]"}]}]}], ")"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
     "\[CapitalDelta]t"}], "]"}]}], "]"}]], "Code",
 CellChangeTimes->{{3.9372908170947037`*^9, 3.9372909100432463`*^9}},
 CellLabel->"In[8]:=",
 CellID->1958345943,ExpressionUUID->"a9db4fee-41c0-4bb6-a4d0-b85be9fb5d03"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{
       SubscriptBox["e", "+"], "[", 
       RowBox[{"\[Alpha]", ",", "sin\[Delta]", ",", "GMST"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["cos\[Iota]", "2"]}], ")"}]}], "-", 
     RowBox[{"\[ImaginaryI]", " ", "cos\[Iota]", " ", 
