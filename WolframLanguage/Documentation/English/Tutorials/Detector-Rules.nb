        " ", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"\\", "hat"}], 
          RowBox[{"{", "\[Phi]", "}"}], " ", "decomposed", " ", 
          RowBox[{"in", " ", "\\", "hat"}], 
