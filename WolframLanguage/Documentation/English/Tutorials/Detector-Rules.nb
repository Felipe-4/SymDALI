}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"pythonFunction", " ", "=", " ", 
  RowBox[{"ExternalFunction", "[", 
   RowBox[{
   "python", ",", " ", 
    "\"\<def function(ra, dec, gps, psi, cosiota, f):\n\tFp = \
detector.antenna_response(ra = ra, dec = dec,  time = gps, psi =psi, mode = \
'plus')\n\tFc = detector.antenna_response(ra = ra, dec = dec,  time = gps, \
psi =psi, mode = 'cross')\n\tdeltaT = detector.time_delay_from_geocenter(ra = \
ra, dec=dec, time = gps )\n\tdeltaT = np.exp(-1j*2*np.pi*f*deltaT)\n\tresult \
= (Fp*0.5*(1+cosiota**2) - complex(0,1)*cosiota*Fc)*deltaT\n\n\treturn result\
\n\>\""}], "]"}]}]], "Code",
 CellChangeTimes->{{3.937365175503315*^9, 3.9373653733251038`*^9}, {
   3.937367241109357*^9, 3.937367297323159*^9}, {3.937367855310604*^9, 
   3.937367856480117*^9}, 3.937367889667341*^9, {3.937367956010376*^9, 
   3.9373679615055447`*^9}, 3.937368027474043*^9},
 CellLabel->"In[19]:=",
 CellID->754236475,ExpressionUUID->"eb96354a-4c50-4bf0-a31f-69c027f25f07"],

