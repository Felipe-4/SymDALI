 CellID->1781169210,ExpressionUUID->"42ace236-cf8d-40c8-ad7f-ecd686bf020b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"test", " ", "=", " ", "CompareFunctions"}], ";"}]], "Input",
 CellChangeTimes->{{3.937368809621318*^9, 3.937368845454791*^9}},
