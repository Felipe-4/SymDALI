Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "make", " ", "some", " ", "trace", " ", "operator", " ", "that", " ", 
    "commutes", " ", "with", " ", 
    RowBox[{"D", ":"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{"Unprotect", "@", "Tr"}], "\n", 
   RowBox[{
    RowBox[{"Tr", "/:", " ", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"Tr", "[", "x_", "]"}], ",", " ", "y___"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Tr", "[", 
      RowBox[{"D", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Tr", "[", "0", "]"}], " ", ":=", " ", "0"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"This", " ", 
      RowBox[{"shoudn", "'"}], "t", " ", "happen", " ", "but", " ", "the", 
      " ", "derivatives", " ", "of", " ", "order", " ", "3", " ", "or", " ", 
      "higher", " ", "in", " ", "cos\[Iota]", " ", "give", " ", "you", " ", 
      "0", " ", "straightfoward"}], ",", " ", "\n", 
     RowBox[{"instead", " ", "of", " ", 
      RowBox[{"Dot", "[", 
       RowBox[{"something", ",", " ", "0", ",", " ", "somethingelse"}], "]"}],
       " ", "in", " ", "any", " ", "case", " ", "you", " ", "can", " ", "do", 
      " ", "this", " ", "with", " ", "trace", " ", "so", " ", "that", " ", 
      "it", " ", "is", " ", "accounted", " ", 
      RowBox[{"for", "."}]}]}], "\n", "*)"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"SymRules", "[", "\"\<detectors\>\"", "]"}], ",", " ", 
       RowBox[{"NRules", "[", "\"\<detectors\>\"", "]"}]}], "}"}], " ", "=", 
     " ", 
     RowBox[{"Module", "[", "\n", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "\[Delta]t", ",", " ", "\[Delta]", ",", " ", "\[Theta]", ",", " ", 
         RowBox[{"\[Phi]", " ", "=", " ", 
          RowBox[{"\[Alpha]", "-", "gmst"}]}], ",", " ", "matrix1", ",", " ", 
         "matrix2", ",", " ", "delta"}], "}"}], ",", "\n", "\n", "\t", 
       RowBox[{
        RowBox[{"\[Theta]", " ", "=", " ", 
         RowBox[{
          RowBox[{"\[Pi]", "/", "2"}], " ", "-", " ", "\[Delta]"}]}], ";", 
        "\n", "\n", "\t", 
        RowBox[{"delta", " ", "=", " ", 
         RowBox[{"\[CapitalDelta]t", "[", 
          RowBox[{
          "detectorPosition", ",", " ", "\[Alpha]", ",", " ", "sin\[Delta]", 
           ",", " ", "gmst"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
        RowBox[{"matrix1", " ", "=", " ", 
         RowBox[{"List", "[", "\n", "        ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
             RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", " ", "0"}], "}"}], ",",
            " ", "\n", "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
              RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"Cos", "[", "\[Theta]", "]"}], " ", 
              RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
             RowBox[{"-", 
              RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}], ",", "\n", 
           "        ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", " ", 
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
              RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", " ", 
             RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], " ", "\n", 
          "    ", "]"}]}], ";", "\n", "\t", "\n", "\t", 
        RowBox[{"matrix1", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"matrix1", "//.", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Sin", "[", "\[Delta]", "]"}], " ", "->", " ", 
               "sin\[Delta]"}], ",", " ", 
              RowBox[{
               RowBox[{"Cos", "[", "\[Delta]", "]"}], "->", " ", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"1", "-", " ", 
                 RowBox[{"sin\[Delta]", "^", "2"}]}], "]"}]}]}], "}"}]}], 
           ")"}], "//", "FullSimplify"}]}], ";", "\n", "\n", "\t", 
        RowBox[{"matrix2", " ", "=", " ", 
         RowBox[{"RotationMatrix", "[", 
          RowBox[{
           RowBox[{"-", "\[Psi]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", "\n", 
        "\n", "\t", 
        RowBox[{
         RowBox[{"Unevaluated", "@", 
          RowBox[{"DerivativeRules", "[", "\n", "\t\t", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"S1", ",", " ", 
              RowBox[{"{", 
               RowBox[{
               "\[Alpha]", ",", " ", "sin\[Delta]", ",", " ", "cos\[Iota]", 
                ",", " ", "\[Psi]"}], "}"}], ",", " ", "5"}], "}"}], ",", 
            "\n", "\n", "\t\t", 
            RowBox[{"$Block", "[", "\n", "\t\t", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{
                "m1", ",", " ", "m2", ",", "m3", ",", "m4", ",", " ", 
                 "\[CapitalDelta]"}], "}"}], "}"}], ",", "\n", "\n", "\t\t", 
              "\n", "\t\t", 
              RowBox[{"(*", 
               RowBox[{
               "NOTE", " ", "THAT", " ", "WE", " ", "ONLY", " ", "DECLARE", 
                " ", "VARIABLES", " ", "THAT", " ", "APPEAR", " ", "IN", " ", 
                "DERIVATIVES"}], "*)"}], "\n", "\t\t", 
              RowBox[{
               RowBox[{
                RowBox[{"\[CapitalDelta]", "[", 
                 RowBox[{"\[Alpha]_", ",", " ", "sin\[Delta]_"}], "]"}], " ", 
                ":=", " ", "DELTA"}], ";", "\n", "\t\t", 
               RowBox[{
                RowBox[{"m1", "[", 
                 RowBox[{"\[Alpha]_", ",", " ", "sin\[Delta]_"}], "]"}], " ", 
                ":=", " ", "MATRIX1"}], ";", "\n", "\t\t", 
               RowBox[{
                RowBox[{"m2", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
                "MATRIX2"}], ";", "\n", "\t\t", 
               RowBox[{
                RowBox[{"m3", "[", 
                 RowBox[{"\[Alpha]_", ",", " ", "sin\[Delta]_"}], "]"}], " ", 
                ":=", " ", "TMATRIX1"}], ";", "\n", "\t\t", 
               RowBox[{
                RowBox[{"m4", "[", "\[Psi]_", "]"}], " ", ":=", " ", 
                "TMATRIX2"}], ";", "\n", "\n", "\t\t", 
               RowBox[{"(*", 
                RowBox[{"T", " ", "=", " ", 
                 RowBox[{"m2", ".", 
                  RowBox[{"m1", ":"}]}]}], "*)"}], "\n", "\t\t", 
               RowBox[{
                RowBox[{"Dot", "[", "\n", "\t\t\t", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"m3", "[", 
                    RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]"}], "]"}], ".", 
                    RowBox[{"m4", "[", "\[Psi]", "]"}], ".", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    FractionBox["1", "2"], " ", 
                    RowBox[{"(", 
                    RowBox[{"1", "+", 
                    SuperscriptBox["cos\[Iota]", "2"]}], ")"}], " ", 
                    "eplus"}], " ", "-", " ", 
                    RowBox[{"I", " ", "cos\[Iota]", " ", "ecross"}]}], ")"}], 
                    ".", 
                    RowBox[{"m2", "[", "\[Psi]", "]"}], ".", 
                    RowBox[{"m1", "[", 
                    RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]"}], "]"}]}], 
                    ")"}], " ", 
                   RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
                    RowBox[{"\[CapitalDelta]", "[", 
                    RowBox[{"\[Alpha]", ",", " ", "sin\[Delta]"}], "]"}]}], 
                    "]"}]}], ",", "\n", "\t\t\t", 
                  SuperscriptBox["detectorTensor", "\[Transpose]"]}], "\n", 
                 "\t\t", "]"}], "//", "Tr"}]}]}], "\n", "\t", "]"}], ",", 
            "\n", "\t", 
            RowBox[{"\"\<KeepDefs\>\"", " ", "->", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"eplus", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", 
                    RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
               " ", 
               RowBox[{"ecross", " ", "->", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]}]}], 
              "}"}]}]}], "\n", "]"}]}], "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"DELTA", " ", "->", "delta"}], ",", " ", 
           RowBox[{"MATRIX1", " ", "->", " ", "matrix1"}], ",", " ", 
           RowBox[{"MATRIX2", " ", "->", " ", "matrix2"}], ",", " ", 
           RowBox[{"TMATRIX1", "->", " ", 
            RowBox[{"Transpose", "[", "matrix1", "]"}]}], ",", " ", 
           RowBox[{"TMATRIX2", " ", "->", " ", 
            RowBox[{"Transpose", "[", "matrix2", "]"}]}]}], "}"}]}]}]}], "\n",
       "\n", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
