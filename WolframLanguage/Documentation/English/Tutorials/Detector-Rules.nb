       RowBox[{"(*", 
        RowBox[{
         RowBox[{"\\", "hat"}], 
         RowBox[{"{", "r", "}"}], "decomposed", " ", 
         RowBox[{"in", " ", "\\", "hat"}], 
         RowBox[{"{", "e", "}"}], "_i"}], "*)"}], "\n", "    ", "]"}]}], ";", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"R1", " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"R1", "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Sin", "[", "\[Delta]", "]"}], " ", "->", " ", 
