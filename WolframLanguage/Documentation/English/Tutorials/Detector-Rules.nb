Cell[CellGroupData[{

Cell["\<\
Now we shall check our definitions for the antenna pattern function. We will \
be using bilby to write the Python representation of \
\>", "Text",
 CellChangeTimes->{{3.937363727985381*^9, 3.9373637574553423`*^9}, {
  3.93736509591098*^9, 3.937365112258522*^9}},
 CellID->534270591,ExpressionUUID->"7267c995-79a1-4c4a-bdd2-031e22ca4a45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"HoldForm", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["T", "\[Transpose]"], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["e", "+"], " ", 
       FractionBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox["cos\[Iota]", "2"]}], ")"}], "2"]}], " ", "-", " ", 
      RowBox[{"I", " ", "cos\[Iota]", " ", 
       SubscriptBox["e", "x"]}]}], ")"}], ".", "T"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "I"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
     "\[CapitalDelta]t"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{3.937365113146082*^9},
 CellLabel->"In[17]:=",
 CellID->2059277833,ExpressionUUID->"09bfda6e-806d-42ba-9634-07a542ace5e9"],

Cell[BoxData[
 TagBox[
  RowBox[{
   RowBox[{
    TemplateBox[{"T"},
     "Transpose"], ".", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], " ", 
       SubscriptBox["e", "+"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["cos\[Iota]", "2"]}], ")"}]}], "-", 
      RowBox[{"\[ImaginaryI]", " ", "cos\[Iota]", " ", 
       SubscriptBox["e", "x"]}]}], ")"}], ".", "T"}], " ", 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "2", " ", "\[Pi]", " ", "f", " ", 
     "\[CapitalDelta]t"}], "]"}]}],
  HoldForm]], "Output",
 CellChangeTimes->{
  3.9373651147964973`*^9, 3.937372178736462*^9, 3.937387649874201*^9, 
   3.937442543378442*^9, 3.937544793267147*^9, {3.939095304526676*^9, 
   3.939095314292985*^9}, 3.939095433995398*^9, 3.939095609569141*^9, 
   3.939095848267323*^9, 3.939096296919553*^9, 3.9391017068854218`*^9, 
   3.939104389749909*^9},
 CellLabel->"Out[17]=",
 CellID->1951683254,ExpressionUUID->"e6ba16ce-fe95-4ba1-87c3-4ef17f611fe7"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "contracted with the detector tensor ",
 Cell[BoxData[
  SubscriptBox["D", "ij"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "3ed79f0d-bcc0-43eb-a0c6-ba3219b2c03a"],
 ". We will be working with the detector 'H1':"
}], "Text",
 CellChangeTimes->{{3.937365118814258*^9, 3.9373651676359386`*^9}},
 CellID->325404676,ExpressionUUID->"d84b1f32-7f51-4934-b6cb-88aa254de8ae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"python", " ", "=", " ", 
   RowBox[{"StartExternalSession", "[", "\"\<Python\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{"python", ",", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<import numpy as np\>\"", ",", " ", "\"\<import bilby\>\""}], 
    "}"}]}], "]"}], "\n", 
 RowBox[{"ExternalEvaluate", "[", 
  RowBox[{
  "python", ",", " ", 
   "\"\<detector = bilby.gw.detector.get_empty_interferometer('H1')\>\""}], 
  "]"}]}], "Code",
 CellChangeTimes->{{3.937363766173126*^9, 3.937363804656872*^9}, {
  3.937363836962021*^9, 3.937363883267528*^9}},
 CellLabel->"In[16]:=",
 CellID->593061547,ExpressionUUID->"fc6892a4-df3f-408d-a432-265d2d91a184"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"Null", ",", "Null"}], "}"}]], "Output",
 CellChangeTimes->{
  3.937363855662559*^9, 3.937363886522435*^9, 3.937372190914117*^9, 
   3.937387654431905*^9, 3.937442550006857*^9, 3.937544798597562*^9, 
