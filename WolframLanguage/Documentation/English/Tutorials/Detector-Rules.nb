Cell[CellGroupData[{

Cell[TextData[{
 "with the understanding that ",
 Cell[BoxData[
  SubscriptBox["e", "+"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "86ac1daf-31cb-4788-b763-3fc01299d772"],
 " and ",
 Cell[BoxData[
  SubscriptBox["e", "x"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "eff4844d-e269-4c56-bf8b-11ce39d9711b"],
 " are matrix functions. The polarization tensors in the geocentric frame are \
defined by similarity transformations:"
}], "Text",
 CellChangeTimes->{{3.9372909311394167`*^9, 3.937291021800975*^9}},
 CellID->742020936,ExpressionUUID->"2dc1f605-20b6-44f7-9123-6c475647a660"],

Cell[BoxData[
 RowBox[{
  RowBox[{"polarizationTensors", "[", 
   RowBox[{"\[Alpha]_", ",", " ", "sin\[Delta]_", ",", " ", "GMST_"}], "]"}], 
  " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\[Theta]", ",", " ", "\[Delta]", ",", " ", 
      RowBox[{"\[Phi]", " ", "=", " ", 
       RowBox[{"\[Alpha]", " ", "-", " ", "GMST"}]}], ",", " ", "eplus", ",", 
