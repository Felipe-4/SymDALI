Cell[CellGroupData[{

Cell["We need a function  that converts GPS to GMST for our defs: ", "Text",
 CellChangeTimes->{{3.937365503606503*^9, 3.937365521944269*^9}},
 CellID->560714062,ExpressionUUID->"255c624d-3739-4c89-b696-d252e9350662"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GMST", " ", "=", " ", 
   RowBox[{"ExternalFunction", "[", 
    RowBox[{
    "python", ",", " ", 
     "\"\<\nfrom astropy.time import Time\ndef gmst_accurate(gps_time):\n    \
gmst = Time(gps_time, format='gps', scale='utc',\n                \
location=(0, 0)).sidereal_time('mean').rad\n    return gmst\>\""}], "\n", 
    "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.9373655230034103`*^9, 3.9373655817526073`*^9}},
 CellLabel->"In[20]:=",
 CellID->142984782,ExpressionUUID->"bccbedd3-6430-4f04-95ff-f8a63aedf2f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "We will need the detector tensor and position of H1, that can be taken from \
",
 ButtonBox["here",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.ligo.org/scientists/GW100916/detectors.txt"], None}],
 ":"
}], "Text",
 CellChangeTimes->{{3.937365587575931*^9, 3.93736561914263*^9}, {
  3.9373656577374077`*^9, 3.937365660218405*^9}},
 CellID->67536353,ExpressionUUID->"1bd9e8ee-e29f-4af3-8558-1071e19acbcc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"H1Tensor", ",", " ", "H1pos"}], "}"}], " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", "\n", "\t", 
      RowBox[{
       RowBox[{"nx", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.22389266154"}], ",", " ", "0.79983062746", ",", 
          "0.55690487831"}], "}"}]}], ",", " ", 
       RowBox[{"ny", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "0.91397818574"}], ",", " ", "0.02609403989", ",", " ", 
          RowBox[{"-", "0.40492342125"}]}], "}"}]}], ",", "\n", "\t", 
       RowBox[{"pos", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2.16141492636"}], " ", 
           SuperscriptBox["10", "6"]}], ",", " ", 
          RowBox[{
           RowBox[{"-", "3.83469517889"}], " ", 
           SuperscriptBox["10", "6"]}], ",", 
          RowBox[{"4.60035022664", " ", 
           SuperscriptBox["10", "6"]}]}], "}"}]}]}], "\n", "}"}], ",", "\n", 
     "\t", 
     RowBox[{"{", "\n", "\t\t", 
      RowBox[{
       RowBox[{"0.5", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"nx", "\[TensorProduct]", "nx"}], " ", "-", " ", 
          RowBox[{"ny", "\[TensorProduct]", "ny"}]}], ")"}]}], ",", "\n", 
       "\t\t", "pos"}], "\n", "\t", "}"}]}], "\n", "\n", "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9373656722137957`*^9, 3.937365710018258*^9}, {
  3.937365750928762*^9, 3.937365800092766*^9}, {3.93736583125879*^9, 
  3.937365895533142*^9}, {3.937365931765663*^9, 3.9373660182858152`*^9}},
 CellLabel->"In[21]:=",
 CellID->415563216,ExpressionUUID->"db23abfa-3bdd-4ace-9e2d-d1064bb2f2e0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Finally, we define a function that takes the detector position and tensor and \
returns our scalar quantity:\
\>", "Text",
 CellChangeTimes->{{3.937366029781687*^9, 3.937366072790502*^9}},
 CellID->957506849,ExpressionUUID->"5c1e632b-9115-4470-a6e5-8c8cdbf02f58"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "the", " ", "detec", " ", "as", " ", "a", " ", "variable", " ",
     "and", " ", "remove", " ", "the", " ", "HoldForm", " ", "from", " ", 
    "the", " ", 
    RowBox[{"definition", ":"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MMAfunction1", "[", 
      RowBox[{
      "\[Alpha]_", ",", " ", "sin\[Delta]_", ",", " ", "\[Psi]_", ",", " ", 
       "gmst_", ",", " ", "cos\[Iota]_", ",", "  ", "detectorPosition_", ",", 
       " ", "detectorTensor_", ",", " ", "f_"}], "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"NRules", "[", "\"\<detectors\>\"", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DownValues", "[", "MMAfunction1", "]"}], " ", "=", " ", 
     RowBox[{
      RowBox[{"DownValues", "[", "MMAfunction1", "]"}], "//.", 
      RowBox[{
       RowBox[{"HoldForm", "[", "x_", "]"}], " ", ":>", " ", "x"}]}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{{3.9373660895174103`*^9, 3.937366095544325*^9}, {
   3.9373662722497396`*^9, 3.9373662975029383`*^9}, {3.937366409948145*^9, 
   3.937366696364449*^9}, {3.9373667264792747`*^9, 3.937366758472024*^9}, 
   3.937366820269348*^9, {3.937366877945822*^9, 3.937366896291502*^9}, {
   3.9373669964681177`*^9, 3.9373670459760313`*^9}, {3.937368148876433*^9, 
   3.937368169760723*^9}, {3.9373722197881308`*^9, 3.937372231988701*^9}, {
   3.9390951327475758`*^9, 3.939095133426379*^9}, {3.939111699135412*^9, 
   3.939111703762031*^9}},
 CellLabel->"In[22]:=",
 CellID->1932817193,ExpressionUUID->"603b5100-020c-4209-9765-31a5598b4af2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now we compare:", "Text",
 CellChangeTimes->{{3.93736710603494*^9, 3.937367111525816*^9}},
 CellID->890856918,ExpressionUUID->"0651dba8-1ad8-494d-b68b-1a7b85235fbf"],

Cell[BoxData[
 RowBox[{"CompareFunctions", " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gps", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          SuperscriptBox["10", "8"], ",", " ", 
          SuperscriptBox["10", "9"]}], "}"}], "]"}]}], ",", " ", 
      RowBox[{"\[Alpha]", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "\[Pi]"}]}], "}"}], "]"}]}], ",", " ", 
      RowBox[{"\[Delta]", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "\[Pi]"}], "/", "2"}], ",", " ", 
          RowBox[{"\[Pi]", "/", "2"}]}], "}"}], "]"}]}], ",", " ", 
      RowBox[{"\[Psi]", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{"0", ",", "\[Pi]"}], "}"}], "]"}]}], ",", " ", 
      RowBox[{"cos\[Iota]", " ", "=", " ", 
       RowBox[{"RandomReal", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], "]"}]}], ",", " ", "\n", 
      "\t", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"20", ",", " ", "4000", ",", " ", "1"}], "]"}]}], ",", " ", 
      "pythonF", ",", " ", "MMA", ",", " ", "gmst"}], "}"}], ",", "\n", "\n", 
    "\t", 
    RowBox[{
     RowBox[{"pythonF", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"pythonFunction", "[", 
         RowBox[{
         "\[Alpha]", ",", " ", "\[Delta]", ",", " ", "gps", ",", " ", 
          "\[Psi]", ",", " ", "cos\[Iota]", ",", " ", "#"}], "]"}], "&"}], "/@",
        "f"}]}], ";", "\n", "\t", 
     RowBox[{"gmst", " ", "=", " ", 
      RowBox[{"GMST", "[", "gps", "]"}]}], ";", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"MMAfunction1", "[", 
         RowBox[{"\[Alpha]", ",", " ", 
          RowBox[{"Sin", "[", "\[Delta]", "]"}], ",", " ", "\[Psi]", ",", " ",
           "gmst", ",", " ", "cos\[Iota]", ",", " ", "H1pos", ",", " ", 
          "H1Tensor", ",", " ", "#"}], "]"}], "&"}], "/@", "f"}]}], ";", "\n",
      "\t", 
     RowBox[{"{", 
      RowBox[{"MMA", ",", " ", "pythonF"}], "}"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.93736711279211*^9, 3.937367123848207*^9}, {
  3.937367611955517*^9, 3.937367825316801*^9}, {3.9373680394892607`*^9, 
  3.9373681261001177`*^9}, {3.9373681970686073`*^9, 3.937368215663126*^9}, {
  3.937368320258625*^9, 3.93736836936672*^9}, {3.937368761588603*^9, 
  3.937368786394597*^9}, {3.9373689450099907`*^9, 3.937368946525724*^9}, {
  3.937372284262559*^9, 3.93737228499478*^9}, {3.939111708159832*^9, 
  3.939111711255314*^9}},
