Cell[BoxData[
 RowBox[{
  RowBox[{"DerivativeRules", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], ",", " ", "2"}], "}"}], ",", "\n", 
    "\t", 
    RowBox[{"$Block", "[", "\n", "\t\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h1", ",", " ", "h2"}], "}"}], ",", "a", ",", " ", "b"}], 
       "}"}], ",", "\n", "\t\t", "\n", "\t\t", 
      RowBox[{
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"x", "-", "y"}]}], ";", "\n", "\t\t", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"x", "+", "y"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
       RowBox[{
        RowBox[{"h1", "[", "b_", "]"}], " ", ":=", " ", 
        RowBox[{"Sin", "[", "b", "]"}]}], ";", "\n", "\t\t", 
       RowBox[{
        RowBox[{"h2", "[", "a_", "]"}], " ", ":=", " ", "a"}], ";", "\n", 
       "\t\t", "\n", "\t\t", 
       RowBox[{"2", " ", 
        RowBox[{"h1", "[", "a", "]"}], " ", 
        RowBox[{"h2", "[", "b", "]"}]}]}]}], "\n", "\t", "]"}], ",", "\n", 
    "\t", 
    RowBox[{"\"\<IncludeZeroDerivative\>\"", " ", "->", " ", "False"}], ",", 
    "\n", "\t", 
    RowBox[{"\"\<KeepDefs\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "->", " ", 
        RowBox[{"x", "-", "y"}]}], ",", " ", 
       RowBox[{"b", "->", 
        RowBox[{"x", "+", "y"}]}]}], "}"}]}]}], "\n", "]"}], "//", 
  "QuietEcho"}]], "Code",
