Cell[BoxData[
 RowBox[{"TestConsistency", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}], ",", " ", "2"}], "}"}], ",", "\n", "\t", 
   RowBox[{"$Block", "[", "\n", "\t\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"h1", ",", " ", "h2", ",", " ", "F"}], "}"}], ",", " ", "a", 
       ",", " ", "b"}], "}"}], ",", "\n", "\t\t", "\n", "\t\t", 
     RowBox[{
      RowBox[{"a", " ", "=", " ", 
       RowBox[{"x", "-", "y"}]}], ";", "\n", "\t\t", 
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"x", "+", "y"}]}], ";", "\n", "\t\t", "\n", "\t\t", 
      RowBox[{
       RowBox[{"h1", "[", "b_", "]"}], " ", ":=", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Sin", "[", "b", "]"}], ",", " ", 
         RowBox[{"Cos", "[", "b", "]"}]}], "}"}]}], ";", "\n", "\t\t", 
      RowBox[{
       RowBox[{"h2", "[", "a_", "]"}], " ", ":=", " ", 
       SuperscriptBox[
        RowBox[{"Cosh", "[", 
         FractionBox["a", "100"], "]"}], "2"]}], ";", "\n", "\t\t", 
      RowBox[{
       RowBox[{"F", "[", 
        RowBox[{"a_", ",", " ", "b_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
