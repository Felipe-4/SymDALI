   RowBox[{"\"\<KeepDefs\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", "->", " ", 
       RowBox[{"x", "-", "y"}]}], ",", " ", 
