Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"$D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", "name"}], "]"}], "[", 
       RowBox[{"x_", ",", "y_"}], "]"}], "\[Rule]", 
      TagBox[
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "$x1", ",", "$x2", ",", "$x4", ",", "$x5", ",", "a", ",", "b"}], 
          "}"}], ",", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{"x", "-", "y"}]}], ";", 
          RowBox[{"b", "=", 
           RowBox[{"x", "+", "y"}]}], ";", 
          RowBox[{"$x1", "=", "b"}], ";", 
          RowBox[{"$x2", "=", "1"}], ";", 
