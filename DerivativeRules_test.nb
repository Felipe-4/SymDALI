         FractionBox[
          RowBox[{"a", "-", "b"}], "100"], "]"}], " ", "+", " ", "c"}]}], ";",
       "\n", "\t\t", "\n", "\t\t", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"h1", "[", 
         RowBox[{"a", " ", 
          RowBox[{"h2", "[", "b", "]"}]}], "]"}]}], " ", "+", " ", 
