 RowBox[{
  RowBox[{
   RowBox[{"h", "[", " ", 
    RowBox[{
    "M_", ",", " ", "\[Eta]_", ",", " ", "\[Chi]1_", ",", " ", "\[Chi]2_", 
     ",", " ", "f_"}], "]"}], " ", "=", " ", 
   RowBox[{"Simplify", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"\[CapitalPsi]", "[", 
         RowBox[{
         "f", ",", "M", ",", "\[Eta]", ",", "\[Chi]1", ",", "\[Chi]2", ",", 
          "0", ",", "0", ",", "20"}], "]"}]}], "]"}], " ", 
      RowBox[{"\[ScriptCapitalA]IMR", "[", 
       RowBox[{
