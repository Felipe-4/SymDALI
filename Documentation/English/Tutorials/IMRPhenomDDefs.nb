Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Attributes", "[", "RelativeDiff", "]"}], " ", "=", " ", 
   RowBox[{"{", "Listable", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"RelativeDiff", "[", 
   RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
  RowBox[{"With", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{"x", "-", "y"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "@", 
      RowBox[{"{", 
       RowBox[{
        FractionBox["diff", "x"], ",", " ", 
        FractionBox["diff", "y"]}], "}"}]}], "]"}]}], "\n", "]"}]}]}], "Code",\

 CellChangeTimes->{{3.936761852895501*^9, 3.9367619365247097`*^9}},
 CellLabel->"In[37]:=",
 CellID->617064174,ExpressionUUID->"df859e26-a8f6-452c-8872-4836267d0703"],

Cell[BoxData[
 RowBox[{"CompareInspiral", " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", " ", 
      RowBox[{"\[Theta]", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
      "coeffs", ",", " ", "\[Chi]s", ",", " ", "\[Chi]a", ",", " ", "\[Eta]", 
      ",", " ", "pythonIns", ",", " ", "MMA", ",", " ", "InspiralPhase", ",", 
      " ", "\n", "\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}], ",", " ", "\n", "\t", "\n",
     "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "100"}], "}"}], ",", " ", "2"}], "]"}]}]}], ";", 
     "\n", "\t", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]]}], ";", "\n", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", " ", "\n", "\t", 
     RowBox[{"\[Chi]s", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", " ", 
     RowBox[{"\[Chi]a", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"20.", ",", " ", "2048.", ",", " ", "0.25"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "G"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]", "]"}]}], ";", "\n", "\t", "\n",
      "\t", 
     RowBox[{"pythonIns", " ", "=", " ", 
      RowBox[{"RippleInspiralPhase", "[", 
       RowBox[{"f", ",", " ", "\[Theta]", ",", " ", "coeffs"}], "]"}]}], ";", 
     "\n", "\n", "\t", 
     RowBox[{"InspiralPhase", "  ", "=", " ", 
      RowBox[{
       RowBox[{"NRules", "[", 
        RowBox[{"[", "\"\<\[Phi]Ins\>\"", "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"InspiralPhase", "[", 
       RowBox[{"f", ",", " ", "\[Eta]", ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"Riffle", "[", 
       RowBox[{"f", ",", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"pythonIns", "-", "MMA"}], ")"}], "/", "pythonIns"}]}], 
       "]"}], "//", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"#", ",", "2"}], "]"}], "&"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"{", "\n", "\t", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"RelativeDiff", "@@", 
          RowBox[{"{", 
           RowBox[{"pythonIns", ",", " ", "MMA"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", "\n", "\t", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"MMA", ",", " ", "pythonIns"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}], ",", " ", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<MMA\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}]}], 
        "]"}]}], "\n", "\t", "}"}]}]}], "\n", "\t", "\n", "]"}]}]], "Code",
 CellChangeTimes->{
