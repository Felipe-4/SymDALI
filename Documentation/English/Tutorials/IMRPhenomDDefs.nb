        "\[Chi]2", ",", " ", "1"}], "]"}]}], ",", "\n", "\t", 
     RowBox[{"ComplexityFunction", "->", "ByteCount"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Code",
