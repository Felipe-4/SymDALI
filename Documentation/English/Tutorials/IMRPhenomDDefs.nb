Cell[CellGroupData[{

Cell["Now, we go for a test:", "Text",
 CellChangeTimes->{{3.935655308498054*^9, 3.935655336394092*^9}, {
  3.935655560078492*^9, 3.9356555655275393`*^9}},
 CellLabel->"In[54]:=",
 CellID->1240412311,ExpressionUUID->"d89e5436-73af-478f-b8e9-7415382192fb"],

Cell[BoxData[
 RowBox[{"test", " ", ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "f", ",", " ", "M", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2", ",", "pos",
       ",", " ", "m1", ",", " ", "m2", ",", "\[Eta]", ",", "tc", ",", " ", 
      "\[Phi]c", ",", " ", "\[Theta]", ",", " ", "Ripple", ",", " ", "MMA", 
      ",", " ", "\[Omega]", ",", " ", "\[Theta]in", ",", " ", "\[Theta]ex", 
      ",", " ", "coeffs", ",", "  ", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "\n", "\t", "}"}], ",", "\n", 
    "\n", "\t", 
    RowBox[{
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"20", ",", " ", "4000", ",", "0.25"}], "]"}]}], ";", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m1", ",", " ", "m2"}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "120"}], "}"}], ",", "2"}], "]"}]}]}], ";", "\n",
      "\t", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"m1", "+", "m2"}], ")"}]}], ";", "\n", "\t", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{"m1", " ", "m2"}], 
       SuperscriptBox["M", "2"]]}], ";", "\n", "\t", 
     RowBox[{"tc", " ", "=", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], "]"}]}], ";", "  ", "\n", 
     "\t", 
     RowBox[{"\[Phi]c", " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "\[Pi]"}], "}"}], "]"}]}], ";", " ", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Chi]1", ",", " ", "\[Chi]2"}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"\[Omega]", " ", "=", " ", 
      RowBox[{"G", " ", "M", " ", "f"}]}], ";", "\n", "\n", "\n", "\t", 
     RowBox[{"\[Theta]ex", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "tc", ",", " ", "\[Phi]c"}], "}"}]}], ";", "\n",
      "\t", 
     RowBox[{"\[Theta]in", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "m2", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], 
       "}"}]}], ";", "\n", "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]in", "]"}]}], ";", "\n", "\n", 
     "\t", 
     RowBox[{"Ripple", " ", "=", " ", 
      RowBox[{"Argument", "[", 
       RowBox[{
       "f", ",", " ", "\[Theta]in", ",", " ", "\[Theta]ex", ",", " ", 
        "coeffs", ",", "  ", "20"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"Ripple", "  ", "=", " ", 
      RowBox[{
       RowBox[{"ResourceFunction", "[", "\"\<PhaseUnwrap\>\"", "]"}], "[", 
       "Ripple", "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"Ripple", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"\[Omega]", ",", " ", "Ripple"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Replace", "[", 
        RowBox[{
         RowBox[{"\[CapitalPsi]", "[", 
          RowBox[{
          "$a", ",", " ", "M", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", 
           " ", "\[Chi]2", ",", " ", "\[Phi]c", ",", " ", "tc", ",", " ", 
           "20"}], "]"}], ",", " ", "rulesList", ",", " ", "Infinity"}], 
        "]"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"MMA", "/.", " ", 
       RowBox[{"$a", " ", "->", "f"}]}]}], ";", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", "MMA"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"Arg", "[", "MMA", "]"}]}], ";", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{"ResourceFunction", "[", "\"\<PhaseUnwrap\>\"", "]"}], "[", 
       "MMA", "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"\[Omega]", ",", "MMA"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"FirstPosition", "[", 
        RowBox[{"\[Omega]", ",", " ", 
         RowBox[{"x_", "/;", " ", 
          RowBox[{"x", ">=", "0.2"}]}]}], "]"}], "//", "Last"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "0.2", " ", "is", " ", "the", " ", "upper", " ", "cutoff", " ", "for", 
       " ", 
       RowBox[{"IMRPhenomD", "."}]}], " ", "*)"}], "\n", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"MMA", ",", " ", "Ripple"}], "}"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", 
        RowBox[{"1", ";;", "pos"}]}], "]"}], "]"}]}]}], "\n", "\t", "\n", 
   "\n", "]"}]}]], "Code",
 CellChangeTimes->{{3.935566913389935*^9, 3.93556726758388*^9}, {
   3.9355673193543253`*^9, 3.9355674083108387`*^9}, {3.935567559949952*^9, 
