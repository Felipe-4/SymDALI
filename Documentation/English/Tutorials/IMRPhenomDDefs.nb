Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"C1", "[", 
    RowBox[{
    "\[Omega]_", ",", " ", "\[Eta]_", ",", " ", "\[Chi]1_", ",", " ", 
     "\[Chi]2_"}], "]"}], " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", "\t", 
      RowBox[{
      "ringdownFrequency", ",", " ", "\[Delta]\[Beta]0", ",", " ", 
       "\[Delta]\[Beta]1", ",", " ", "\[Delta]\[Alpha]0", ",", " ", 
       "\[Delta]\[Alpha]1"}], "\n", "\t", "}"}], ",", "\n", "\t", "\n", "\t", 
     
     RowBox[{
      RowBox[{"ringdownFrequency", " ", "=", " ", 
       RowBox[{"\[Omega]RD", "[", 
        RowBox[{"\[Eta]", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}]}],
       ";", "\n", "\n", "\t", 
      RowBox[{"\[Delta]\[Beta]1", " ", "=", 
       RowBox[{"(", "\n", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"$D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", 
            "\[Phi]Ins"}], "]"}], "[", 
          RowBox[{
          "0.018", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
           "\[Chi]2"}], "]"}], " ", "-", " ", "\n", "\t\t", 
         RowBox[{
          RowBox[{"$D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0", ",", " ", "0"}], "}"}], ",", 
            " ", "\[Phi]Int"}], "]"}], "[", 
          RowBox[{
          "0.018", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
           "\[Chi]2"}], "]"}]}], "\n", "\t", ")"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"\[Delta]\[Beta]0", " ", "=", " ", 
       RowBox[{
        RowBox[{"\[Phi]Ins", "[", 
         RowBox[{
         "0.018", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}], " ", "-", " ", 
        RowBox[{"\[Phi]Int", "[", 
         RowBox[{
         "0.018", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}], " ", "-", " ", 
        RowBox[{"\[Delta]\[Beta]1", " ", "0.018"}]}]}], ";", "\n", "\n", "\t", 
      RowBox[{"\[Delta]\[Alpha]1", " ", "=", " ", 
       RowBox[{"(", "\n", "\t\t", 
        RowBox[{
         RowBox[{
          RowBox[{"$D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", 
            "\[Phi]Int"}], "]"}], "[", 
          RowBox[{
           RowBox[{"ringdownFrequency", "/", "2"}], ",", " ", "\[Eta]", ",", 
           " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}], " ", "+", " ", 
         "\[Delta]\[Beta]1", "-", " ", "\n", "\t\t", 
         RowBox[{
          RowBox[{"$D", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
            "\[Phi]MR"}], "]"}], "[", 
          RowBox[{
           FractionBox["ringdownFrequency", "2"], ",", " ", "\[Eta]", ",", 
           " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}]}], "\n", "\t", 
        ")"}]}], ";", "\n", "\n", "\t", 
      RowBox[{"\[Delta]\[Alpha]0", " ", "=", " ", 
       RowBox[{"(", "\n", "\t\t", 
        RowBox[{
         RowBox[{"\[Phi]Int", "[", 
          RowBox[{
           FractionBox["ringdownFrequency", "2"], ",", " ", "\[Eta]", ",", 
           " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Delta]\[Beta]1", " ", 
          FractionBox["ringdownFrequency", "2"]}], " ", "+", " ", 
         "\[Delta]\[Beta]0", " ", "-", " ", "\n", "\t\t", 
         RowBox[{"\[Phi]MR", "[", 
          RowBox[{
           FractionBox["ringdownFrequency", "2"], ",", " ", "\[Eta]", ",", 
           " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}], " ", "-", " ", 
         RowBox[{"\[Delta]\[Alpha]1", " ", 
          FractionBox["ringdownFrequency", "2"]}]}], "\n", "\t", ")"}]}], ";",
       "\n", "\n", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Delta]\[Beta]0", " ", "+", " ", 
          RowBox[{"\[Delta]\[Beta]1", " ", "\[Omega]"}]}], ")"}], " ", 
        RowBox[{"us\[Theta]", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            FractionBox["ringdownFrequency", "2"], " ", "-", " ", 
            "\[Omega]"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"\[Omega]", "-", "0.018"}], ")"}]}], "]"}]}], " ", "+", 
       " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Delta]\[Alpha]0", " ", "+", " ", 
          RowBox[{"\[Delta]\[Alpha]1", " ", "\[Omega]"}]}], ")"}], " ", 
        RowBox[{"us\[Theta]", "[", 
         RowBox[{"\[Omega]", " ", "-", " ", 
          FractionBox["ringdownFrequency", "2"]}], "]"}]}]}]}]}], "\n", 
    "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.934966613949662*^9, 3.934966615330922*^9}, {
