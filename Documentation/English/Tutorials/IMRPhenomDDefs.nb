Cell[CellGroupData[{

Cell["\<\
It will also be convenient to organize the necessary rules for evaluation in \
a list:\
\>", "Text",
 CellChangeTimes->{{3.9356546055017157`*^9, 3.935654640966905*^9}},
 CellID->776329106,ExpressionUUID->"6dc1d76d-b003-4971-a5cc-9a5663199196"],

Cell[BoxData[
 RowBox[{"Module", "[", "\n", "\t", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "allVars", ",", " ", "takeVars", ",", " ", "compiledFunctions", ",", " ", 
     "extra"}], "}"}], ",", "\n", "\t", "\n", "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"takeVars", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"List", "@@", "x"}], ")"}], "/.", " ", 
      RowBox[{"q_Pattern", " ", ":>", " ", 
       RowBox[{"q", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", "\n", "\t", "\n", "\t", 
    RowBox[{"rulesList", "  ", "=", " ", 
     RowBox[{"NRules", "/@", 
      RowBox[{"(", 
       RowBox[{"Keys", "@", "NRules"}], ")"}]}]}], ";", "\n", "\n", "\t", 
    RowBox[{"rulesList", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"rulesList", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"1", ";;", "5"}]}], "]"}], "]"}], "]"}]}], ";", "\n", "\t", 
    "\n", "\t", 
    RowBox[{"allVars", " ", "=", " ", 
     RowBox[{"takeVars", " ", "/@", " ", 
      RowBox[{"rulesList", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}]}], ";", "\n", "\n", 
    "\t", 
    RowBox[{"compiledFunctions", " ", "=", " ", 
     RowBox[{"MapThread", "[", "\n", "   \t\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"Sequence", " ", "@@", " ", "#2"}], "]"}], " ", "&"}], ",", 
       "\n", "   \t\t\t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rulesList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
         "allVars"}], " ", "}"}]}], "\n", "   \t\t", "]"}]}], ";", "\n", "\t",
     "\n", "\t", 
    RowBox[{"rulesList", " ", "=", " ", 
     RowBox[{"MapThread", "[", "\n", "   \t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", " ", "->", " ", "#2"}], " ", "&"}], ",", "\n", 
       "   \t\t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rulesList", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
         "compiledFunctions"}], "}"}]}], "\n", "   \t", "]"}]}], ";", "\n", 
    "\n", "\t", 
    RowBox[{"rulesList", " ", "=", " ", 
     RowBox[{"Dispatch", "[", "rulesList", "]"}]}], ";"}]}], "\n", "\n", 
  "]"}]], "Code",
