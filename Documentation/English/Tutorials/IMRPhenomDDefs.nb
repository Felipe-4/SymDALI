Cell[CellGroupData[{

Cell["\<\
Now we can define the full phase, which will depend on the basic variables, \
meaning that we will be eliminating S,  \[Chi]PN and \[Omega]:\
\>", "Text",
 CellChangeTimes->{{3.935549116530517*^9, 3.935549125209002*^9}, {
  3.935549286545657*^9, 3.935549336394855*^9}, {3.935549382549388*^9, 
  3.9355493964720087`*^9}},
 CellID->1639750403,ExpressionUUID->"16d8e1c6-0e7b-489c-9a63-a764b0d31a27"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[CapitalPsi]", "[", 
   RowBox[{
   "f_", ",", " ", "M_", ",", " ", "\[Eta]_", ",", " ", "\[Chi]1_", ",", " ", 
    "\[Chi]2_", ",", " ", "\[Phi]c_", ",", " ", "tc_", ",", " ", "fref_"}], 
   "]"}], "  ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", 
     RowBox[{
     "ringdownFrequency", ",", " ", "PeakFrequency", ",", " ", "\[Chi]PN", 
      ",", " ", 
      RowBox[{"\[Chi]s", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Chi]1", "+", "\[Chi]2"}], ")"}], "/", "2"}]}], ",", " ", 
      RowBox[{"\[Chi]a", " ", "=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[Chi]1", "-", "\[Chi]2"}], ")"}], "/", "2"}]}], ",", "\n", 
      "\t\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "\[Omega]", ",", "aeff", 
      ",", "  ", "\[Omega]ref", ",", "\n", "\t\t", "t0"}], "\n", "\t", "}"}], 
    ",", "\n", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{"\[Chi]PN", " ", "=", " ", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", " ", 
          RowBox[{"4", " ", "\[Eta]"}]}]], " ", "\[Chi]a"}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"76", " ", "\[Eta]"}], "113"]}], ")"}], " ", 
        "\[Chi]s"}]}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"\[Omega]", " ", "=", " ", 
      RowBox[{"G", " ", "M", " ", "f"}]}], ";", "\n", "\t", 
     RowBox[{"\[Omega]ref", " ", "=", " ", 
      RowBox[{"G", " ", "M", " ", "fref"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"ringdownFrequency", " ", "=", " ", 
      RowBox[{"\[Omega]RD", "[", 
       RowBox[{"\[Eta]", ",", "  ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}]}],
      ";", "\n", "\n", "\t", 
     RowBox[{"PeakFrequency", " ", "=", " ", 
      RowBox[{"\[Omega]Peak", "[", 
       RowBox[{"\[Eta]", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], "]"}]}], 
     ";", "\n", "\n", "\t", 
     RowBox[{"t0", " ", "=", "  ", 
      RowBox[{
       RowBox[{"$D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", 
         "\[Phi]MR"}], "]"}], "[", "\n", "\t\t\t", 
       RowBox[{
       "PeakFrequency", ",", "\n", "\t\t\t", "\[Eta]", ",", " ", "\n", 
        "\t\t\t", "\[Chi]1", ",", " ", "\n", "\t\t\t", "\[Chi]2"}], "\n", 
       "\t\t", "]"}]}], ";", "\n", "\n", "\n", "\t", 
     RowBox[{"(*", 
      RowBox[{"Now", ",", " ", 
       RowBox[{
       "we", " ", "can", " ", "Finally", " ", "write", " ", "the", " ", 
        "symbolic", " ", 
        RowBox[{"expression", ":"}]}]}], "*)"}], "\n", "\t", 
     RowBox[{
      RowBox[{"\[Phi]IMR", "[", 
       RowBox[{
       "\[Omega]", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
        "\[Chi]2"}], "]"}], " ", "-", " ", 
      RowBox[{"\[Phi]IMR", "[", 
       RowBox[{
       "\[Omega]ref", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
        "\[Chi]2"}], "]"}], "  ", "-", " ", 
      RowBox[{"t0", " ", 
       RowBox[{"(", 
        RowBox[{"\[Omega]", " ", "-", " ", "\[Omega]ref"}], ")"}]}], " ", "-",
       "  ", 
      RowBox[{"2", " ", "\[Phi]c"}], " ", "+", " ", 
      RowBox[{"2", " ", "\[Pi]", " ", "tc", " ", "f"}]}]}]}], "\n", "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"//", 
     RowBox[{
      RowBox[{"Simplify", "[", "\n", "\t", 
       RowBox[{"#", ",", " ", "\n", "\t", 
        RowBox[{"ComplexityFunction", "->", "ByteCount"}], ",", " ", "\n", 
        "\t", 
        RowBox[{"Assumptions", "->", " ", 
         RowBox[{
          RowBox[{"0", "<", "\[Eta]", "<", 
           RowBox[{"1", "/", "4"}]}], " ", "&&", 
          RowBox[{"M", ">", "0"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"-", "1"}], "<=", "\[Chi]1", " ", "<=", "1"}], " ", "&&", 
          " ", 
          RowBox[{
           RowBox[{"-", "1"}], "<=", "\[Chi]2", " ", "<=", "1"}], " ", "&&", 
          " ", 
          RowBox[{"f", ">", "0"}], " ", "&&", 
          RowBox[{"fref", ">", "0"}]}]}]}], "\n", "]"}], "&"}]}], ";"}], 
   "*)"}]}]], "Code",
 CellChangeTimes->{{3.9355491512235823`*^9, 3.9355491809691677`*^9}, {
   3.9355493556198397`*^9, 3.9355493573260937`*^9}, {3.9355493997448874`*^9, 
   3.935549416339786*^9}, {3.935549464662191*^9, 3.9355494792223577`*^9}, {
