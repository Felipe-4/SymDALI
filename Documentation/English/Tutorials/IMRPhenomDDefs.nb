Cell[BoxData[
 RowBox[{"test\[ScriptCapitalA]", " ", ":=", " ", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "f", ",", " ", "M", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2", ",", "pos",
       ",", " ", "m1", ",", " ", "m2", ",", "\[Eta]", ",", " ", "\[Theta]", 
      ",", " ", "Ripple", ",", " ", "MMA", ",", " ", "\[Omega]", ",", " ", 
      "\[Theta]in", ",", " ", "\[Theta]ex", ",", " ", "coeffs", ",", "  ", 
      "ripplefreqs", ",", "\[Omega]p", ",", "\n", "\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], "\n", "\t", "}"}], ",", "\n", 
    "\n", "\t", 
    RowBox[{
     RowBox[{"f", " ", "=", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"20", ",", " ", "4000", ",", "0.25"}], "]"}]}], ";", "\n", 
     "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m1", ",", " ", "m2"}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "120"}], "}"}], ",", "2"}], "]"}]}]}], ";", "\n",
      "\t", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{"(", 
       RowBox[{"m1", "+", "m2"}], ")"}]}], ";", "\n", "\t", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{"m1", " ", "m2"}], 
       SuperscriptBox["M", "2"]]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Chi]1", ",", " ", "\[Chi]2"}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"\[Omega]", " ", "=", " ", 
      RowBox[{"G", " ", "M", " ", "f"}]}], ";", "\n", "\n", "\n", "\t", 
     RowBox[{"\[Theta]ex", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0", ",", " ", "0"}], "}"}]}], ";", "\n", "\t", 
     
     RowBox[{"\[Theta]in", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"m1", ",", "m2", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], 
       "}"}]}], ";", "\n", "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]in", "]"}]}], ";", "\n", "\t", 
     RowBox[{"ripplefreqs", " ", "=", " ", 
      RowBox[{"RippleTransitionFrequencies", "[", 
       RowBox[{"\[Theta]in", ",", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "6", "]"}], "]"}], ",", " ", 
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "7", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"\[Omega]p", " ", "=", " ", 
      RowBox[{
       RowBox[{"ripplefreqs", "[", 
        RowBox[{"[", "4", "]"}], "]"}], " ", "G", " ", "M"}]}], ";", "\n", 
     "\t", "\n", "\n", "\t", 
     RowBox[{"Ripple", " ", "=", " ", 
      RowBox[{"Amplitude", "[", 
       RowBox[{
       "f", ",", " ", "\[Theta]in", ",", " ", "\[Theta]ex", ",", " ", 
        "coeffs", ",", "  ", "20"}], "]"}]}], ";", "\n", "\n", "\t", 
     RowBox[{"Ripple", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"\[Omega]", ",", " ", "Ripple"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{"Quiet", "[", 
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"\[ScriptCapitalA]IMR", "[", 
           RowBox[{
           "$a", ",", " ", "M", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", 
            " ", "\[Chi]2", ",", " ", 
            SuperscriptBox["10", 
             RowBox[{"-", "3"}]]}], "]"}], ",", " ", "rulesList", ",", " ", 
          "Infinity"}], "]"}], "]"}], "/.", "rulesList"}]}], ";", "\n", "\t", 
     
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"MMA", "/.", " ", 
       RowBox[{"$a", " ", "->", "f"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"\[Omega]", ",", "MMA"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"FirstPosition", "[", 
        RowBox[{"\[Omega]", ",", " ", 
         RowBox[{"x_", "/;", " ", 
          RowBox[{"x", ">=", "0.2"}]}]}], "]"}], "//", "Last"}]}], ";", " ", 
     RowBox[{"(*", 
      RowBox[{
      "0.2", " ", "is", " ", "the", " ", "upper", " ", "cutoff", " ", "for", 
       " ", 
       RowBox[{"IMRPhenomD", "."}]}], " ", "*)"}], "\n", "\n", "\t", 
     RowBox[{"ListLinePlot", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"MMA", ",", " ", "Ripple"}], "}"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{"1", ";;", "pos"}]}], "]"}], "]"}], ",", " ", 
       RowBox[{"PlotRange", "->", "All"}], ",", " ", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<MMA\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}], ",", 
       " ", 
       RowBox[{"ImageSize", "->", "Medium"}], ",", "\n", "\t\t", 
       RowBox[{"GridLines", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0.014", ",", " ", "Red"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"\[Omega]p", ",", " ", "Red"}], "}"}]}], "}"}], ",", " ",
           "None"}], "}"}]}]}], "\n", "\t", "]"}]}]}], "\n", "]"}]}]], "Code",\

