Cell[CellGroupData[{

Cell["\<\
It would be wise to compare this rather large and complicated function \
against an answer we know to be right:\
\>", "Text",
 CellChangeTimes->{{3.935565513674303*^9, 3.935565547586381*^9}, {
  3.935565949694812*^9, 3.9355659503870163`*^9}, {3.935566591515019*^9, 
