 CellID->110510807,ExpressionUUID->"cb3d945f-a39c-4fd8-8979-75366e9d0a81"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"helperCoeffs", " ", "=", " ", 
    RowBox[{"ExternalFunction", "[", 
     RowBox[{
     "python", ",", " ", 
      "\"\<def Coeffs(theta):\n\ta = IMRD_utils.get_coeffs(theta)\n\treturn \
np.array(a)\>\""}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RippleCoeffs", "[", "\[Theta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"helperCoeffs", "[", "\[Theta]", "]"}], "//", "Normal"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helperArg", " ", "=", " ", 
    RowBox[{"ExternalFunction", "[", 
     RowBox[{
     "python", ",", " ", 
      "\"\<def h0(f, \[Theta]in, \[Theta]extr, coeffs,  fref):\n\tb = \
np.array(f)\n\ta = IMRD._gen_IMRPhenomD(b, \[Theta]in, \[Theta]extr, coeffs,  \
fref)\n\treturn np.array(a)\>\""}], "\n", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"the", " ", "function", " ", "takes", " ", "the", " ", 
     RowBox[{"arguments", ":", " ", "Mc"}]}], ",", " ", "eta", ",", " ", 
    "chi1", ",", " ", "chi2", ",", " ", "dist_mpc", ",", " ", "tc", ",", " ", 
    "phic", ",", " ", "inclination"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Argument", "[", 
   RowBox[{
   "f_", ",", " ", "\[Theta]in_", ",", "\[Theta]ex_", ",", " ", "coeffs_", 
    ",", " ", "fref_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Arg", "[", 
   RowBox[{
    RowBox[{"helperArg", "[", 
     RowBox[{
     "f", ",", " ", "\[Theta]in", ",", " ", "\[Theta]ex", ",", " ", "coeffs", 
      ",", " ", "fref"}], "]"}], "//", "Normal"}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
   "we", " ", "only", " ", "need", " ", "hp", " ", "for", " ", "the", " ", 
    RowBox[{"phase", "."}]}], "*)"}]}]}], "Code",
 CellChangeTimes->{{3.935653473059184*^9, 3.935653477209846*^9}, {
   3.935653615903318*^9, 3.9356536306761627`*^9}, {3.935653663705377*^9, 
