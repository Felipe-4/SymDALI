Cell[BoxData[
 RowBox[{"CompareInt", " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"f", ",", " ", 
      RowBox[{"\[Theta]", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
      "coeffs", ",", " ", "\[Chi]s", ",", " ", "\[Chi]a", ",", " ", "\[Eta]", 
      ",", " ", "pythonInt", ",", " ", "MMAInt", ",", "\n", "\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "\n", "\t", "\[Chi]PN"}], 
     "}"}], ",", " ", "\n", "\t", "\n", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "100"}], "}"}], ",", " ", "2"}], "]"}]}]}], ";", 
     " ", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]]}], ";", "\n", "\t", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", " ", 
     RowBox[{"\[Chi]s", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", " ", 
     RowBox[{"\[Chi]a", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"20.", ",", " ", "2048.", ",", " ", "0.25"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "G"}]}], ";", "\n", 
     "\t", "\n", "\n", "\t", 
     RowBox[{"\[Chi]PN", " ", "=", " ", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", " ", 
          RowBox[{"4", " ", "\[Eta]"}]}]], " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "  ", "-", " ", 
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "2"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"76", " ", "\[Eta]"}], "113"]}], ")"}], " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "2"]}]}]}], ";", "\n", 
     "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]", "]"}]}], ";", "\n", "\t", "\n",
      "\t", 
     RowBox[{"pythonInt", " ", "=", " ", 
      RowBox[{"RippleIntPhase", "[", 
       RowBox[{"f", ",", " ", "\[Theta]", ",", " ", "coeffs"}], "]"}]}], ";", 
     "\n", "\n", "\t", "\n", "\t", 
     RowBox[{"MMAInt", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"NRules", "[", "\"\<\[Phi]Int\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"f", ",", " ", "\[Eta]", ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"RelativeDiff", "@@", 
          RowBox[{"{", 
           RowBox[{"MMAInt", ",", " ", "pythonInt"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", "\n", "\t", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"MMAInt", ",", " ", "pythonInt"}], "}"}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}], ",", " ", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<MMA\>\"", ",", " ", "\"\<Python\>\""}], "}"}]}]}], 
        "]"}]}], "\n", "\t", "}"}]}]}], "\n", "]"}]}]], "Code",
