Cell[BoxData[
 RowBox[{"CompareMR", " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", "\n", "\t\t", 
     RowBox[{"f", ",", " ", 
      RowBox[{"\[Theta]", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ",", " ", 
      "coeffs", ",", " ", "\[Chi]s", ",", " ", "\[Chi]a", ",", " ", "\[Eta]", 
      ",", " ", "pythonIns", ",", " ", "MMA", ",", " ", "fRD", ",", " ", 
      "fDAMP", ",", " ", "omegaRD", ",", " ", "\[Omega]DAMP", ",", "\n", 
      "\t\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", "\[Chi]PN", ",", " ", 
      "position", ",", " ", "\[Omega]RDMMA"}], "\n", "\t", "}"}], ",", " ", 
    "\n", "\t", "\n", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "100"}], "}"}], ",", " ", "2"}], "]"}]}]}], ";", 
     " ", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}], "2"]]}], ";", "\n", "\t", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", " ", 
     RowBox[{"\[Chi]s", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", " ", 
     RowBox[{"\[Chi]a", " ", "=", " ", 
      RowBox[{
       RowBox[{"1", "/", "2"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], ";", "\n", "\t", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"20.", ",", " ", "2048.", ",", " ", "0.25"}], "]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ")"}], " ", "G"}]}], ";", "\n", 
     "\n", "\t", 
     RowBox[{"\[Chi]PN", " ", "=", " ", 
      RowBox[{
       RowBox[{
        SqrtBox[
         RowBox[{"1", "-", " ", 
          RowBox[{"4", " ", "\[Eta]"}]}]], " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "  ", "-", " ", 
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "2"]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox[
           RowBox[{"76", " ", "\[Eta]"}], "113"]}], ")"}], " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "3", "]"}], "]"}], " ", "+", " ", 
           RowBox[{"\[Theta]", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}], ")"}], "2"]}]}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]", "]"}]}], ";", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"fRD", ",", " ", "fDAMP"}], "}"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"RippleTransitionFrequencies", "[", 
         RowBox[{"\[Theta]", ",", " ", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"coeffs", "[", 
            RowBox[{"[", 
             RowBox[{"6", ";;", "7"}], "]"}], "]"}]}]}], "]"}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "2"}], ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{"pythonIns", " ", "=", " ", 
      RowBox[{"RippleMRPhase", "[", 
       RowBox[{
       "f", ",", " ", "\[Theta]", ",", " ", "coeffs", ",", " ", "fRD", ",", 
        " ", "fDAMP"}], "]"}]}], ";", "\n", "\t", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"omegaRD", ",", " ", "\[Omega]DAMP"}], "}"}], " ", "=", "  ", 
      RowBox[{"G", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
         RowBox[{"\[Theta]", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], " ", ")"}], " ", 
       RowBox[{"{", 
        RowBox[{"fRD", ",", " ", "fDAMP"}], "}"}]}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"NRules", "[", "\"\<\[Phi]MR\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"f", ",", " ", "\[Eta]", ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", "\n", "\t", "\n", 
     "\t", 
     RowBox[{"position", " ", "=", " ", 
      RowBox[{
       RowBox[{"FirstPosition", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">=", "0.2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Length", "@", "f"}], "}"}]}], "]"}], "//", "Last"}]}], ";",
      "\n", "\t", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"Take", "[", 
       RowBox[{"MMA", ",", " ", "position"}], "]"}]}], ";", "\n", "\t", 
     RowBox[{"pythonIns", " ", "=", " ", 
      RowBox[{"Take", "[", 
       RowBox[{"pythonIns", ",", " ", "position"}], "]"}]}], ";", "\n", "\n", 
     "\t", 
     RowBox[{"{", "\n", "\t\t", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"RelativeDiff", "@@", 
          RowBox[{"{", 
           RowBox[{"pythonIns", ",", " ", "MMA"}], "}"}]}], ",", " ", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"omegaRD", "/", "2"}], ",", " ", "Red"}], "}"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"\[Omega]DAMP", ",", " ", "Black"}], "}"}]}], "}"}], 
            ",", " ", "None"}], "}"}]}], ",", "\n", "\t\t\t", 
         RowBox[{"PlotRange", "->", " ", "All"}], ",", " ", 
         RowBox[{"DataRange", " ", "->", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"f", "[", 
             RowBox[{"[", "position", "]"}], "]"}]}], "}"}]}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "\n", "\t\t", "]"}], ",", 
       "\n", "\t\t", 
       RowBox[{"ListPlot", "[", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"MMA", ",", " ", "pythonIns"}], "}"}], ",", " ", 
         RowBox[{"PlotLegends", "->", " ", 
          RowBox[{"{", 
           RowBox[{"\"\<MMA\>\"", ",", " ", "\"\<python\>\""}], "}"}]}], ",", 
         " ", "\n", "\t\t\t", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"omegaRD", "/", "2"}], ",", " ", "Red"}], "}"}], "}"}],
             ",", " ", "None"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"DataRange", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"f", "[", 
             RowBox[{"[", "position", "]"}], "]"}]}], "}"}]}], ",", "\n", 
         "\t\t\t", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "\n", "\t\t", "]"}]}], "\n",
       "\t", "}"}]}]}], "\n", "]"}]}]], "Code",
