         RowBox[{"$\[Chi]2", " ", "->", 
          RowBox[{"\[Theta]", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}]}], ";", "\n", "\t", 
     "\n", "\t", "\n", "\t", 
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{"RelativeDiff", "@@", 
       RowBox[{"{", 
        RowBox[{"MMA", ",", " ", "pythonPhase"}], "}"}]}]}], ";", "\n", "\t", 
     "\n", "\t", 
     RowBox[{"diff", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"f", ",", " ", "diff"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\n", "\t", 
     RowBox[{"ringdown", " ", "=", " ", 
      RowBox[{
       RowBox[{"transition", "[", 
        RowBox[{"[", 
         RowBox[{"-", "2"}], "]"}], "]"}], " ", "M", " ", "G"}]}], ";", "\n", 
     "\t", 
     RowBox[{"pos", " ", "=", " ", 
      RowBox[{
       RowBox[{"FirstPosition", "[", 
        RowBox[{"f", ",", " ", 
         RowBox[{"x_", "/;", 
          RowBox[{"x", ">=", "0.2"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Length", "@", "f"}], "}"}]}], "]"}], "//", "Last"}]}], ";",
      " ", 
     RowBox[{"(*", 
      RowBox[{
      "Upper", " ", "cuttoff", " ", "for", " ", "the", " ", "waveform"}], 
      "*)"}], "\n", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"f", ",", " ", "MMA"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t", 
     RowBox[{"pythonPhase", " ", "=", " ", 
      RowBox[{
       RowBox[{"Riffle", "[", 
        RowBox[{"f", ",", " ", "pythonPhase"}], "]"}], "//", 
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{"#", ",", "2"}], "]"}], "&"}]}]}], ";", "\n", "\t", 
     RowBox[{"{", "\n", "\t\t", 
      RowBox[{
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"diff", ",", " ", "pos"}], "]"}], ",", " ", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0.018", ",", "Red"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"ringdown", "/", "2"}], ",", " ", "Red"}], "}"}]}], 
             "}"}], ",", " ", "None"}], "}"}]}], ",", " ", 
         RowBox[{"PlotRange", "->", "All"}], ",", " ", 
         RowBox[{"ImageSize", "->", "Medium"}]}], "]"}], ",", "\n", "\t\t", 
       RowBox[{"ListLinePlot", "[", "\n", "\t\t\t", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Take", "[", 
            RowBox[{"pythonPhase", ",", " ", "pos"}], "]"}], ",", " ", 
           RowBox[{"Take", "[", 
            RowBox[{"MMA", ",", " ", "pos"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
