Cell[CellGroupData[{

Cell["Now, we can define:", "Text",
 CellChangeTimes->{{3.935724198878091*^9, 3.935724205696332*^9}},
 CellID->1465218751,ExpressionUUID->"39d1d092-1a94-4060-b25f-c2fd8120c708"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[ScriptCapitalA]IMR", "[", 
    RowBox[{
    "f_", ",", " ", "M_", ",", "  ", "\[Eta]_", ",", " ", "\[Chi]1_", ",", 
     " ", "\[Chi]2_", ",", " ", "dL_"}], "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"Module", "[", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "S", ",", " ", "aeff", ",", " ", "\[Chi]PN", ",", "ringdownFrequency", 
        ",", " ", "DampingFrequency", ",", " ", "\[Omega]3", ",", " ", "v1", 
        ",", "V2", ",", "v3", ",", " ", "d1", ",", " ", "d3", ",", " ", 
        "\[Omega]", ",", " ", "c", ",", " ", "G", ",", " ", "\[Omega]2", ",", 
        " ", "\[ScriptCapitalA]0"}], "}"}], ",", "\n", "\t", "\n", "\t", 
      RowBox[{"(*", 
       RowBox[{
       "We", " ", "need", " ", "a", " ", "lot", " ", "of", " ", "definitions",
         " ", 
        RowBox[{"first", ":"}]}], "*)"}], "\n", "\t", 
      RowBox[{
       RowBox[{"S", " ", "=", "  ", 
        RowBox[{
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", " ", "+", " ", 
             SqrtBox[
              RowBox[{"1", "-", 
               RowBox[{"4", " ", "\[Eta]"}]}]]}], ")"}], "2"], " ", 
          "\[Chi]1"}], " ", "+", " ", 
         RowBox[{
          FractionBox["1", "4"], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SqrtBox[
              RowBox[{"1", "-", 
               RowBox[{"4", " ", "\[Eta]"}]}]]}], ")"}], "2"], " ", 
          "\[Chi]2"}]}]}], ";", "\n", "\t", 
       RowBox[{"aeff", " ", "=", " ", 
        RowBox[{"S", " ", "+", " ", 
         RowBox[{"2", " ", 
          SqrtBox["3."], " ", "\[Eta]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "0.085`"}], " ", "S"}], " ", "+", " ", 
            RowBox[{"0.102`", " ", 
             SuperscriptBox["S", "2"]}], " ", "-", " ", 
            RowBox[{"1.355`", " ", 
             SuperscriptBox["S", "3"]}], "-", 
            RowBox[{"0.868`", " ", 
             SuperscriptBox["S", "4"]}]}], ")"}], " ", "\[Eta]"}], " ", "-", 
         " ", 
         RowBox[{"4.399`", " ", 
          SuperscriptBox["\[Eta]", "2"]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "5.837`"}], " ", "S"}], "-", 
            RowBox[{"2.097`", " ", 
             SuperscriptBox["S", "2"]}], "+", 
            RowBox[{"4.109`", " ", 
             SuperscriptBox["S", "3"]}], "+", 
            RowBox[{"2.064`", " ", 
             SuperscriptBox["S", "4"]}]}], ")"}], " ", 
          SuperscriptBox["\[Eta]", "2"]}], "+", 
         RowBox[{"9.397`", " ", 
          SuperscriptBox["\[Eta]", "3"]}], "-", 
         RowBox[{"13.181`", " ", 
          SuperscriptBox["\[Eta]", "4"]}]}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"ringdownFrequency", " ", "=", " ", 
        RowBox[{"\[Omega]RD", "[", 
         RowBox[{"\[Eta]", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], 
         "]"}]}], ";", "\n", "\n", "\n", "\t", 
       RowBox[{"\[Omega]3", " ", "=", " ", 
        RowBox[{"\[Omega]Peak", "[", 
         RowBox[{"\[Eta]", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], 
         "]"}]}], ";", "\n", "\t", "\n", "\t", 
       RowBox[{"\[Omega]2", " ", "=", " ", 
        FractionBox[
         RowBox[{"(", 
          RowBox[{"\[Omega]3", "+", "0.014"}], ")"}], "2"]}], ";", "\n", "\t", 
       RowBox[{"v1", " ", "=", " ", 
        RowBox[{"\[ScriptCapitalA]Ins", "[", 
         RowBox[{
         "0.014", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"V2", " ", "=", " ", 
        RowBox[{
         SuperscriptBox["\[Omega]2", 
          RowBox[{
           RowBox[{"-", "7"}], "/", "6"}]], " ", 
         SqrtBox["\[Eta]"], " ", 
         RowBox[{"v2", "[", 
          RowBox[{"\[Eta]", ",", " ", "\[Chi]1", ",", " ", "\[Chi]2"}], 
          "]"}]}]}], ";", "\n", "\t", 
       RowBox[{"v3", " ", "=", " ", 
        RowBox[{"\[ScriptCapitalA]MR", "[", 
         RowBox[{
         "\[Omega]3", ",", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"d1", " ", "=", " ", 
        RowBox[{
         RowBox[{"$D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", " ", 
           "\[ScriptCapitalA]Ins"}], "]"}], "[", 
         RowBox[{
         "0.014", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"d3", " ", "=", " ", 
        RowBox[{
         RowBox[{"$D", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
           "\[ScriptCapitalA]MR"}], "]"}], "[", 
         RowBox[{
         "\[Omega]3", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
          "\[Chi]2"}], "]"}]}], ";", "\n", "\n", "\n", "\t", 
       RowBox[{"G", "=", 
        RowBox[{
         RowBox[{"UnitConvert", "[", 
          RowBox[{
           FractionBox["\"\<GravitationalConstant\>\"", 
            SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
           FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
         
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{
         RowBox[{"UnitConvert", "[", 
          RowBox[{"\"\<SpeedOfLight\>\"", ",", " ", 
           FractionBox["\"\<Gigaparsecs\>\"", "\"\<Seconds\>\""]}], "]"}], 
         "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "\t", 
       RowBox[{"\[Omega]", " ", "=", " ", 
        RowBox[{"M", "*", "f", "*", "G"}]}], ";", "\n", "\n", "\t", 
       RowBox[{"(*", 
        RowBox[{"Now", ",", " ", 
         RowBox[{
         "we", " ", "can", " ", "just", " ", "write", " ", "down", " ", "the",
           " ", 
          RowBox[{"function", ":"}]}]}], "*)"}], "\n", "\t", 
       RowBox[{"\[ScriptCapitalA]0", " ", "=", " ", 
        RowBox[{
         SqrtBox[
          FractionBox["5", "6"]], " ", 
         FractionBox["c", 
          RowBox[{"2", " ", 
           SuperscriptBox["\[Pi]", 
            RowBox[{"2", "/", "3"}]]}]], " ", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"M", " ", "G"}], ")"}], "2"], "dL"]}]}], ";", "\n", "\n", 
       "\t", 
       RowBox[{"\[ScriptCapitalA]0", "*", 
        RowBox[{"(", "\n", "\t\t", 
         RowBox[{
          RowBox[{
           RowBox[{"\[ScriptCapitalA]Ins", "[", 
            RowBox[{
            "\[Omega]", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
             "\[Chi]2"}], "]"}], " ", 
           RowBox[{"us\[Theta]", "[", 
            RowBox[{"0.014", "-", "\[Omega]"}], "]"}]}], " ", "+", " ", "\n", 
          "\t\t", 
          RowBox[{
           RowBox[{"\[ScriptCapitalA]Int", "[", 
            RowBox[{
            "\[Omega]", ",", " ", "\[Omega]3", ",", " ", "v1", ",", "V2", ",",
              "v3", ",", "d1", ",", "d3"}], "]"}], " ", 
           RowBox[{"us\[Theta]", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Omega]", "-", "0.014"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"\[Omega]3", "-", " ", "\[Omega]"}], ")"}]}], "]"}]}], 
          " ", "+", " ", "\n", "\t\t", 
          RowBox[{
           RowBox[{"\[ScriptCapitalA]MR", "[", 
            RowBox[{
            "\[Omega]", ",", " ", "\[Eta]", ",", " ", "\[Chi]1", ",", " ", 
             "\[Chi]2"}], "]"}], " ", 
           RowBox[{"us\[Theta]", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\[Omega]", "-", "\[Omega]3"}], ")"}], " ", 
             RowBox[{"(", 
              RowBox[{"0.2", " ", "-", " ", "\[Omega]"}], ")"}]}], "]"}]}]}], 
         "\n", "\t", ")"}]}]}]}], "\n", "]"}], "//", 
    RowBox[{
     RowBox[{"Simplify", "[", "\n", "\t", 
      RowBox[{"#", ",", "\n", "\t", 
       RowBox[{"Assumptions", "->", " ", 
        RowBox[{
         RowBox[{"0", "<", "f"}], " ", "&&", " ", 
         RowBox[{"0", "<", "\[Eta]", "<", 
          RowBox[{"1", "/", "4"}]}], " ", "&&", " ", 
         RowBox[{"0", "<", "M"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"-", "1"}], "<=", " ", "\[Chi]1", " ", "<=", "1"}], "&&", 
         RowBox[{
          RowBox[{"-", "1"}], "<=", " ", "\[Chi]2", " ", "<=", "1"}]}]}], ",",
        "\n", "\t", 
       RowBox[{"ComplexityFunction", "->", "ByteCount"}]}], "\n", "\t", "]"}],
      "&"}]}]}], ";"}]], "Code",
 CellChangeTimes->{{3.935724363346548*^9, 3.935724996058271*^9}, {
   3.935725036916448*^9, 3.935725108019424*^9}, {3.935725197624916*^9, 
   3.935725510244459*^9}, {3.93572557449883*^9, 3.9357255801082373`*^9}, {
   3.935726134485311*^9, 3.935726150410605*^9}, {3.935726237745473*^9, 
   3.935726243964533*^9}, {3.935726301002963*^9, 3.935726458051107*^9}, {
   3.9357265065759163`*^9, 3.9357267231476383`*^9}, {3.9357267579002943`*^9, 
   3.935726859455954*^9}, {3.935726905150722*^9, 3.935726905394298*^9}, {
   3.935727659554681*^9, 3.935727713026949*^9}, {3.935727870858204*^9, 
   3.935727878070256*^9}, {3.935732840021532*^9, 3.935732841205756*^9}, {
   3.935733325721149*^9, 3.935733375712846*^9}, 3.935735375483779*^9, {
   3.9357354706239233`*^9, 3.935735488849675*^9}, {3.9357359328507347`*^9, 
   3.935735933487957*^9}, {3.9357359682997437`*^9, 3.9357359729699507`*^9}, {
   3.9357362632378674`*^9, 3.935736297211645*^9}, {3.936778365363978*^9, 
   3.936778384184209*^9}, {3.9367784301169033`*^9, 3.936778485954084*^9}, {
   3.936778516445106*^9, 3.936778525241095*^9}, {3.936778556247764*^9, 
   3.936778630031578*^9}, {3.9367786792478456`*^9, 3.936778684659738*^9}, {
   3.936944224805912*^9, 3.936944231232869*^9}, {3.9375406071529427`*^9, 
   3.93754060892463*^9}, {3.93754178297333*^9, 3.9375417853091917`*^9}, {
   3.939280287826386*^9, 3.939280298787841*^9}},
 CellLabel->"In[57]:=",
 CellID->1274965871,ExpressionUUID->"196931f1-6adf-4c35-b917-8e458744d3e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Now, we define some helper function to do the comparison:", "Text",
 CellChangeTimes->{{3.935727002351986*^9, 3.9357270175753183`*^9}},
 CellID->1318520958,ExpressionUUID->"3e008535-e421-4258-8241-cdbafe426c4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"helperCoeffs", " ", "=", " ", 
    RowBox[{"ExternalFunction", "[", 
     RowBox[{
     "python", ",", " ", 
      "\"\<def Coeffs(theta):\n\ta = IMRD_utils.get_coeffs(theta)\n\treturn \
np.array(a)\>\""}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RippleCoeffs", "[", "\[Theta]_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"helperCoeffs", "[", "\[Theta]", "]"}], "//", "Normal"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helperArg", " ", "=", " ", 
    RowBox[{"ExternalFunction", "[", 
     RowBox[{
     "python", ",", " ", 
      "\"\<def h0(f, \[Theta]in, \[Theta]extr, coeffs,  fref):\n\tb = \
np.array(f)\n\ta = IMRD._gen_IMRPhenomD(b, \[Theta]in, \[Theta]extr, coeffs,  \
fref)\n\treturn np.array(a)\>\""}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Amplitude", "[", 
   RowBox[{
   "f_", ",", " ", "\[Theta]in_", ",", "\[Theta]ex_", ",", " ", "coeffs_", 
    ",", " ", "fref_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Abs", "[", 
   RowBox[{
    RowBox[{"helperArg", "[", 
     RowBox[{
     "f", ",", " ", "\[Theta]in", ",", " ", "\[Theta]ex", ",", " ", "coeffs", 
      ",", " ", "fref"}], "]"}], "//", "Normal"}], "]"}]}]}], "Code",
