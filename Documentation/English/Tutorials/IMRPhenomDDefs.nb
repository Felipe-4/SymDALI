Cell[BoxData[
 RowBox[{"ComparePhase", " ", ":=", " ", 
  RowBox[{"Module", "[", "\n", "\t", 
   RowBox[{
    RowBox[{"{", "\n", "\t", 
     RowBox[{
     "f", ",", "  ", "coeffs", ",", " ", "\[Theta]", ",", "  ", "\[Eta]", ",",
       " ", "pythonPhase", ",", " ", "MMA", ",", " ", "fRD", ",", " ", 
      "fDAMP", ",", " ", "transition", ",", " ", "M", ",", " ", "diff", ",", 
      " ", "\n", "\t", 
      RowBox[{"G", " ", "=", " ", 
       RowBox[{
        RowBox[{"UnitConvert", "[", 
         RowBox[{
          FractionBox["\"\<GravitationalConstant\>\"", 
           SuperscriptBox["\"\<SpeedOfLight\>\"", "3"]], ",", " ", 
          FractionBox["\"\<Seconds\>\"", "\"\<SolarMass\>\""]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", "  ", "b", ",", " ", 
      "ringdown", ",", " ", "pos"}], "\n", "\t", "}"}], ",", " ", "\n", "\n", 
    "\t", 
    RowBox[{
     RowBox[{"\[Theta]", " ", "=", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";", "\n", "\t", 
     
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"ReverseSort", "@", 
       RowBox[{"RandomReal", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"10", ",", "130"}], "}"}], ",", " ", "2"}], "]"}]}]}], ";", 
     " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "3", "]"}], "]"}], ",", " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "}"}], " ", "=", " ", 
      RowBox[{"RandomReal", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", " ", "2"}], "]"}]}], 
     ";", "\n", "\t", "\n", "\n", "\t", 
     RowBox[{"M", " ", "=", " ", 
      RowBox[{
       RowBox[{"\[Theta]", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "+", " ", 
       RowBox[{"\[Theta]", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "  ", "\n", "\t", 
     RowBox[{"\[Eta]", " ", "=", " ", 
      FractionBox[
       RowBox[{
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}], " ", 
        RowBox[{"\[Theta]", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], 
       SuperscriptBox["M", "2"]]}], ";", "\n", "\t", 
     RowBox[{"f", " ", "=", " ", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"20.", ",", " ", "2048.", ",", " ", "0.25"}], "]"}], " ", "M",
        " ", "G"}]}], ";", "\n", "\n", "\t\t", "\n", "\t", 
     RowBox[{"coeffs", " ", "=", " ", 
      RowBox[{"RippleCoeffs", "[", "\[Theta]", "]"}]}], ";", "\n", "\t", 
     RowBox[{"transition", " ", "=", " ", 
      RowBox[{"RippleTransitionFrequencies", "[", 
       RowBox[{"\[Theta]", ",", "  ", 
        RowBox[{"Sequence", "@@", 
         RowBox[{"coeffs", "[", 
          RowBox[{"[", 
           RowBox[{"6", ";;", "7"}], "]"}], "]"}]}]}], " ", "]"}]}], ";", 
     "\n", "\n", "\n", "\t", 
     RowBox[{"pythonPhase", " ", "=", " ", 
      RowBox[{"RippleTotalPhase", "[", 
       RowBox[{
        FractionBox["f", 
         RowBox[{"M", " ", "G"}]], ",", " ", "\[Theta]", ",", " ", "coeffs", 
        ",", " ", "transition"}], "]"}]}], ";", "\n", "\t", "\n", "\t", "\n", 
     "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"Replace", "[", 
         RowBox[{
          RowBox[{"\[Phi]IMR", "[", 
           RowBox[{
           "$f", ",", " ", "$\[Eta]", ",", " ", "$\[Chi]1", ",", " ", 
            "$\[Chi]2"}], "]"}], ",", " ", "rulesList", ",", " ", 
          "Infinity"}], "]"}], ",", " ", 
        RowBox[{"CompiledFunction", "::", "cfsa"}]}], "]"}]}], ";", "\n", 
     "\t", "\n", "\t", 
     RowBox[{"MMA", " ", "=", " ", 
      RowBox[{"MMA", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"$f", "->", " ", "f"}], ",", " ", 
         RowBox[{"$\[Eta]", "->", "\[Eta]"}], ",", " ", 
         RowBox[{"$\[Chi]1", "->", 
