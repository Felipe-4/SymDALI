Cell["\<\
However some of these phases and amplitudes have additional definitions, \
which we shall work out along the way.\
\>", "Text",
 CellChangeTimes->{{3.934963156338749*^9, 3.934963227189776*^9}},
 CellID->545928202,ExpressionUUID->"8a46970d-5dad-4673-9da6-0e10e3516e4b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Lastly, we shall compare our definitions against the ",
 ButtonBox["Ripple",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/2302.05329"], None}],
 " package, which is known to agree with the LIGO implementation.  For that, \
we need a Python session:"
}], "Text",
 CellChangeTimes->{{3.9356528768413773`*^9, 3.935652934462675*^9}, {
  3.935652973037939*^9, 3.935652999447659*^9}, {3.935653088457903*^9, 
  3.935653097102013*^9}},
 CellID->11683488,ExpressionUUID->"f8a23ba9-1751-46d6-a8dd-418739fa8ea1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"python", " ", "=", " ", 
   RowBox[{"StartExternalSession", "[", "\[IndentingNewLine]", "\t", 
    RowBox[{"{", "\n", "\[IndentingNewLine]", "\t\t", 
     RowBox[{"\"\<System\>\"", " ", "->", " ", "\"\<Python\>\""}], "\n", 
     "    ", "}"}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.930458142138789*^9, 3.930458154418102*^9}, {
   3.930616531946032*^9, 3.930616597065399*^9}, {3.930616631503161*^9, 
   3.93061664306518*^9}, {3.9306166778134193`*^9, 3.930616733675205*^9}, {
   3.930616945857061*^9, 3.930616973834053*^9}, {3.930617057820465*^9, 
   3.930617253124107*^9}, {3.930618934745922*^9, 3.930618936707004*^9}, {
   3.9306213041960697`*^9, 3.930621330727683*^9}, {3.930632371435143*^9, 
   3.930632388796069*^9}, 3.93571112047519*^9, {3.935716470019402*^9, 
   3.935716477049128*^9}, {3.935720311617072*^9, 3.93572031274336*^9}},
 CellLabel->"In[7]:=",
 CellID->601328681,ExpressionUUID->"634e80ab-b4c5-440c-8674-1844b18741ec"],

