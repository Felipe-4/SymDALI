  RowBox[{
  "\"\<Python\>\"", ",", 
   "\"\<from astropy.time import Time\n\n# GPS time for GW150914\ngps_time = \
1187008882.4\n\n# Convert GPS time to UTC and then to GMST in radians\ntime = \
Time(gps_time, format='gps', scale='utc')\ngmst_radians = \
time.sidereal_time('mean', 'greenwich').radian\n\nprint(\\\"GMST in \
radians:\\\", gmst_radians)\n\>\""}], "]"}]], "Code",
